module main

// md5: the MD5 digest (RFC 1321) of 8 MiB of generated bytes. Blocks of 64
// bytes one after another (`evolve`), each starting from the last one's
// state; in a block, 64 steps as a function that calls itself with the four
// state words. Checked against Python's `hashlib`.

fn ks() -> [i64] {
    [0xd76aa478 0xe8c7b756 0x242070db 0xc1bdceee 0xf57c0faf 0x4787c62a 0xa8304613 0xfd469501
     0x698098d8 0x8b44f7af 0xffff5bb1 0x895cd7be 0x6b901122 0xfd987193 0xa679438e 0x49b40821
     0xf61e2562 0xc040b340 0x265e5a51 0xe9b6c7aa 0xd62f105d 0x02441453 0xd8a1e681 0xe7d3fbc8
     0x21e1cde6 0xc33707d6 0xf4d50d87 0x455a14ed 0xa9e3e905 0xfcefa3f8 0x676f02d9 0x8d2a4c8a
     0xfffa3942 0x8771f681 0x6d9d6122 0xfde5380c 0xa4beea44 0x4bdecfa9 0xf6bb4b60 0xbebfbc70
     0x289b7ec6 0xeaa127fa 0xd4ef3085 0x04881d05 0xd9d4d039 0xe6db99e5 0x1fa27cf8 0xc4ac5665
     0xf4292244 0x432aff97 0xab9423a7 0xfc93a039 0x655b59c3 0x8f0ccc92 0xffeff47d 0x85845dd1
     0x6fa87e4f 0xfe2ce6e0 0xa3014314 0x4e0811a1 0xf7537e82 0xbd3af235 0x2ad7d2bb 0xeb86d391]
}

fn ss() -> [i64] {
    [7 12 17 22 7 12 17 22 7 12 17 22 7 12 17 22
     5 9 14 20 5 9 14 20 5 9 14 20 5 9 14 20
     4 11 16 23 4 11 16 23 4 11 16 23 4 11 16 23
     6 10 15 21 6 10 15 21 6 10 15 21 6 10 15 21]
}

fn rotl(x: i64, r: i64) -> i64 { (x << r | x >>> (32 - r)) & 0xFFFFFFFF }

// the 32-bit word g of the block at off, little-endian
fn word(msg: [u8], off: i64, g: i64) -> i64 {
    let p = off + 4 * g
    msg[p] | msg[p + 1] << 8 | msg[p + 2] << 16 | msg[p + 3] << 24
}

// steps i … 63 of the block at off
fn steps(msg: [u8], off: i64, k: [i64], s: [i64], i: i64, a: i64, b: i64, c: i64, d: i64) -> (i64, i64, i64, i64) {
    if i == 64 { (a, b, c, d) } else {
        let f = if i < 16 { b & c | (b ^ 0xFFFFFFFF) & d }
            else if i < 32 { d & b | (d ^ 0xFFFFFFFF) & c }
            else if i < 48 { b ^ c ^ d }
            else { c ^ (b | (d ^ 0xFFFFFFFF)) }
        let g = if i < 16 { i } else if i < 32 { (5 * i + 1) % 16 } else if i < 48 { (3 * i + 5) % 16 } else { 7 * i % 16 }
        let t = (f + a + k[i] + word(msg, off, g)) & 0xFFFFFFFF
        steps(msg, off, k, s, i + 1, d, (b + rotl(t, s[i])) & 0xFFFFFFFF, b, c)
    }
}

// the state after the blocks so far: where the next block starts, and the
// four words
type H = { off: i64, a: i64, b: i64, c: i64, d: i64 }

fn block(h: H, msg: [u8], k: [i64], s: [i64]) -> H {
    let (a1, b1, c1, d1) = steps(msg, h.off, k, s, 0, h.a, h.b, h.c, h.d)
    { h with off: h.off + 64, a: (h.a + a1) & 0xFFFFFFFF, b: (h.b + b1) & 0xFFFFFFFF, c: (h.c + c1) & 0xFFFFFFFF, d: (h.d + d1) & 0xFFFFFFFF }
}

fn main() {
    let n = 1 << 23
    // the data, then the padding: 0x80, zeros, and the length in bits
    // (little-endian); the data is whole blocks, so the padding is one more
    let bits = n * 8
    let msg = bytes::from(⍳ (n + 64) ¨ (i => {
        if i < n { (i * 2654435761 >> 13) & 255 }
        else if i == n { 128 }
        else if i < n + 56 { 0 }
        else { bits >> ((i - n - 56) * 8) & 255 }
    }))
    let (k, s) = (ks(), ss())
    let r = H { off: 0, a: 0x67452301, b: 0xefcdab89, c: 0x98badcfe, d: 0x10325476 } ▷ evolve(≢ msg div 64, h => block(h, msg, k, s))
    let h = [r.a r.b r.c r.d]
    print(bytes::hex(bytes::from(⍳ 16 ¨ (i => h[i div 4] >> (i % 4 * 8) & 255))))
}
