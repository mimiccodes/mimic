module main

// sort on numbers uses a parallel radix sort: same results as comparing.

fn main() {
    print(sort([5 ¯3 0 9223372036854775807 ¯9223372036854775807 2 2 ¯1]))
    print(sort([2.5 ¯1.5 0.0 1e300 ¯1e300 0.25 2.5]))
    print(sort(bytes::from([200 3 255 0 3])))
    print(sort([true false true false]))
    print(sort([7]))
    print(sort(⍳ 0))
    print(sort(["pear" "apple" "fig"]))
    // a large one, sorted in parallel chunks
    let n = 300000
    let xs = ⍳ n ¨ (i => (i * 7919 + 13) % 100003 - 50000)
    let s = sort(xs)
    print("{s[0]} {s[1]} {s[n div 2]} {s[n - 1]}")
    print((⍳ (n - 1) ¨ (i => if s[i] <= s[i + 1] { 0 } else { 1 })) ▷ +/)   // out of order: none
    print((s ▷ +/) == (xs ▷ +/))
}
