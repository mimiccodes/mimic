module main

// Collections and the system (0.2.7): unique, sort_by, zip, enumerate,
// any/all, count, group_by, flatten, min_by/max_by, clamp, to_map, sets,
// assert, fs::walk, fs::modified, os::env_all, time::format patterns,
// random::shuffle / choice.

type Person = { name: str, age: i64 }

fn main() {
    print(unique([3 1 3 2 1]))
    print(unique(["b" "a" "b"]))
    let people = [Person { name: "ada", age: 36 } Person { name: "bob", age: 25 } Person { name: "cy", age: 36 }]
    print(sort_by(people, p => p.age) ¨ (p => p.name))
    print(sort_by(["pear" "fig" "apple"], s => ≢ s, descending: true))
    print(zip([1 2 3], ["a" "b"]))
    print(enumerate(["x" "y"]))
    print((any([1 2 3] > 2), all([1 2 3] > 0), any([1 2] > 5), all([] > 0)))
    print(count([1 2 3 4], x => x % 2 == 0))
    print(group_by(["apple" "avocado" "banana"], s => slice(s, 0, 1)))
    print(flatten([[1 2] [3] [4 5]]))
    print((min_by(people, p => p.age), max_by([3 9 2], x => x), min_by([], x => x)))
    print((clamp(15, 0, 10), clamp([¯5 5 50], 0, 10)))
    print(to_map([("a", 1) ("b", 2) ("a", 3)]))
    let s = set::of([1 2 2 3])
    print((set::has(s, 2), set::has(s, 9), set::size(set::add(s, 7))))
    print((set::items(set::union(s, set::of([3 4]))), set::items(set::intersection(s, set::of([2 3 9]))), set::items(set::difference(s, set::of([2])))))
    let t = time::timestamp(2026, 11, 14, 21, 5, 7)
    print(time::format(t, "%Y-%m-%d %H:%M:%S.%f, %A %B %d (%a %b), day %j, %I %p %%"))
    print(time::format(t))
    random::seed(7)
    print(sort(random::shuffle([5 3 1 4 2])))
    let picked = random::choice(["only"]) else { return }
    print(picked)
    let tree = path::join(fs::temp_dir(), "mimic-walk")
    fs::make_dir(path::join(tree, "sub"))
    fs::write(path::join(tree, "a.txt"), "a")
    fs::write(path::join(tree, "sub/b.txt"), "b")
    print(fs::walk(tree))
    let when = fs::modified(path::join(tree, "a.txt")) else { return }
    print(when > time::timestamp(2020, 1, 1, 0, 0, 0))
    print(has(os::env_all(), "MIMIC_FIXTURE_NOT_SET"))
    assert(≢ unique([1 1]) == 1, "unique keeps one")
    print("done")
}
