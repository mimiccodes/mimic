module main

// chacha20: the ChaCha20 stream cipher of RFC 8439 (key bytes 0-31, nonce
// 000000090000004a00000000, counter from 1) over 8 MiB of generated bytes.
// Each 64-byte block of key stream is worked out on its own, in parallel:
// its 16 words are a list in a record, changed in place by each quarter
// round (`put`s in a `with`), ten double rounds by `evolve`. The blocks'
// bytes are flattened into one stream and xored with the data. Prints a
// checksum that weighs every encrypted byte by its position, and the first
// 16 encrypted bytes. The reference is bench/chacha20/ref.py (checked
// against the RFC's test vector).

fn rotl(x: i64, r: i64) -> i64 { (x << r | x >>> (32 - r)) & 0xFFFFFFFF }

type S = { v: [i64] }

fn qr(s: S, a: i64, b: i64, c: i64, d: i64) -> S {
    let a1 = (s.v[a] + s.v[b]) & 0xFFFFFFFF
    let d1 = rotl(s.v[d] ^ a1, 16)
    let c1 = (s.v[c] + d1) & 0xFFFFFFFF
    let b1 = rotl(s.v[b] ^ c1, 12)
    let a2 = (a1 + b1) & 0xFFFFFFFF
    let d2 = rotl(d1 ^ a2, 8)
    let c2 = (c1 + d2) & 0xFFFFFFFF
    let b2 = rotl(b1 ^ c2, 7)
    { s with v: put(put(put(put(s.v, a, a2), b, b2), c, c2), d, d2) }
}

fn double_round(s: S) -> S {
    let cols = qr(qr(qr(qr(s, 0, 4, 8, 12), 1, 5, 9, 13), 2, 6, 10, 14), 3, 7, 11, 15)
    qr(qr(qr(qr(cols, 0, 5, 10, 15), 1, 6, 11, 12), 2, 7, 8, 13), 3, 4, 9, 14)
}

// the 64 key-stream bytes of block `counter`
fn block(key: [i64], nonce: [i64], counter: i64) -> [i64] {
    let init = concat(concat(concat([0x61707865 0x3320646E 0x79622D32 0x6B206574], key), [counter]), nonce)
    let v = (S { v: init } ▷ evolve(10, double_round)).v
    ⍳ 64 ¨ (j => ((v[j div 4] + init[j div 4]) & 0xFFFFFFFF) >>> (8 * (j % 4)) & 255)
}

// little-endian 32-bit words of bytes
fn words(bs: [i64]) -> [i64] { ⍳ (≢ bs div 4) ¨ (w => bs[4 * w] | bs[4 * w + 1] << 8 | bs[4 * w + 2] << 16 | bs[4 * w + 3] << 24) }

fn main() {
    let n = 1 << 23
    let key = words(⍳ 32)
    let nonce = words([0 0 0 9 0 0 0 74 0 0 0 0])
    let stream = bytes::from(flatten(⍳ (n div 64) ¨ (b => block(key, nonce, 1 + b))))
    let out = bytes::from(⍳ n ¨ (i => (i * 2654435761 >> 13) & 255 ^ stream[i]))
    let check = ⍳ n ¨ (i => out[i] * (i % 251 + 1)) ▷ +/
    print("{check} {bytes::hex(out ↑ 16)}")
}
