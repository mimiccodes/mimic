module main

// murmur3: MurmurHash3 (x86, 32-bit, seed 0) of 8 MiB of generated bytes,
// four bytes (little-endian) at a time, then the final mix. One sequential
// pass over the blocks.

fn rotl(x: i64, r: i64) -> i64 { (x << r | x >>> (32 - r)) & 0xFFFFFFFF }

fn block(h: i64, k0: i64) -> i64 {
    let k = rotl(k0 * 0xcc9e2d51 & 0xFFFFFFFF, 15) * 0x1b873593 & 0xFFFFFFFF
    (rotl(h ^ k, 13) * 5 + 0xe6546b64) & 0xFFFFFFFF
}

fn fmix(h0: i64) -> i64 {
    let h1 = (h0 ^ h0 >>> 16) * 0x85ebca6b & 0xFFFFFFFF
    let h2 = (h1 ^ h1 >>> 13) * 0xc2b2ae35 & 0xFFFFFFFF
    h2 ^ h2 >>> 16
}

fn main() {
    let n = 1 << 23
    let data = ⍳ n ¨ (i => (i * 2654435761 >> 13) & 255)
    let blocks = n div 4
    let (_, h) = (0, 0) ▷ settle(s => {
        let p = s.0 * 4
        (s.0 + 1, block(s.1, data[p] | data[p + 1] << 8 | data[p + 2] << 16 | data[p + 3] << 24))
    }, s => s.0 == blocks)
    print(fmix(h ^ n))
}
