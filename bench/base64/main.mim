module main

// base64: 6 MiB of generated bytes encoded as base64 (RFC 4648, standard
// alphabet) and decoded again. Every group of 3 bytes becomes 4 characters
// on its own, so both directions are one `¨` over the groups. Prints the
// encoded length, the sum of its character codes and 1 when the decoded
// bytes equal the original.

fn main() {
    let n = 6 * 1024 * 1024
    let data = ⍳ n ¨ (i => (i * 2654435761 >> 13) & 255)
    let alphabet = bytes::of_text("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    // encode: 3 bytes → 24 bits → 4 characters (n is a multiple of 3)
    let encoded = ⍳ (n div 3 * 4) ¨ (k => {
        let g = k div 4 * 3
        let bits = data[g] << 16 | data[g + 1] << 8 | data[g + 2]
        alphabet[bits >> (18 - k % 4 * 6) & 63]
    })
    // decode: each character's value, then 4 values → 3 bytes
    let value = ⍳ 256 ¨ (c => if c >= 65 and c <= 90 { c - 65 } else if c >= 97 and c <= 122 { c - 71 } else if c >= 48 and c <= 57 { c + 4 } else if c == 43 { 62 } else { 63 })
    let decoded = ⍳ n ¨ (i => {
        let q = i div 3 * 4
        let bits = value[encoded[q]] << 18 | value[encoded[q + 1]] << 12 | value[encoded[q + 2]] << 6 | value[encoded[q + 3]]
        bits >> (16 - i % 3 * 8) & 255
    })
    let same = if +/ (decoded != data) == 0 { 1 } else { 0 }
    print("{≢ encoded} {+/ encoded} {same}")
}
