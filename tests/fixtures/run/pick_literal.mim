module main

// a list of strings written out and indexed at once: only the element
// picked is made (formatted text included); the same results as the list

fn tag(i: i64, k: i64) -> str {
    ["" "" "-alpha.{k}" "-beta.{k + 1}" "-rc" "-x{k * 2}y"][i % 6]
}

fn named(d: i64) -> str { ["sun" "mon" "tue" "wed" "thu" "fri" "sat"][d] }

fn main() {
    print(⍳ 8 ¨ (i => "[{tag(i, 3)}]") ▷ join(" "))
    print(named(0) + " " + named(6))
    let k = 4
    let words = ["a{k}" "b" "c{k}"]
    print("{words[2]} {≢ words}")
}
