module main

// base32: 4,000,000 generated bytes encoded as Base32 (RFC 4648: each group
// of 5 bytes becomes 8 letters of A-Z2-7) and decoded again. Both ways are
// one map over the output, in parallel: a letter reads the (one or two)
// bytes its 5 bits come from, and a byte the (two or three) letters that
// hold its 8. Prints the length of the text, a checksum that weighs every
// letter by its position, and 1 when decoding gives the bytes back.
// Checked against Python's base64 module.

fn alphabet() -> [u8] { bytes::of_text("ABCDEFGHIJKLMNOPQRSTUVWXYZ234567") }

// the value of a Base32 letter
fn value(c: i64) -> i64 { if c >= 65 { c - 65 } else { c - 24 } }

// bits [p, p + w) of a byte list read as one bit stream, most significant
// first
fn bits(b: [u8], p: i64, w: i64) -> i64 {
    let (i, o) = (p div 8, p % 8)
    let two = b[i] << 8 | (if i + 1 < ≢ b { b[i + 1] } else { 0 })
    two >>> (16 - o - w) & ((1 << w) - 1)
}

fn main() {
    let n = 4000000
    let data = bytes::from(⍳ n ¨ (i => (i * 2654435761 >> 13) & 255))
    let abc = alphabet()
    let text = bytes::from(⍳ (n * 8 div 5) ¨ (j => abc[bits(data, 5 * j, 5)]))
    let check = ⍳ (≢ text) ¨ (i => text[i] * (i % 251 + 1)) ▷ +/
    let vals = bytes::from(text ¨ value)
    // byte i is bits 8i … 8i + 7 of the 5-bit values: in the letters at
    // 8i div 5 and on
    let back = bytes::from(⍳ n ¨ (i => {
        let (j, o) = (8 * i div 5, 8 * i % 5)
        let three = vals[j] << 10 | vals[j + 1] << 5 | (if j + 2 < ≢ vals { vals[j + 2] } else { 0 })
        three >>> (7 - o) & 255
    }))
    let same = if all(⍳ n ¨ (i => back[i] == data[i])) { 1 } else { 0 }
    print("{≢ text} {check} {same}")
}
