module main

// coprime: over all pairs (i, j) with 1 <= i, j <= 4,000, how many have
// gcd 1, and the sum of all the gcds, by Euclid's algorithm (a function
// that calls itself). One map over the 16,000,000 pairs, in parallel. The
// reference is bench/coprime/ref.py.

fn gcd(a: i64, b: i64) -> i64 { if b == 0 { a } else { gcd(b, a % b) } }

fn main() {
    let n = 4000
    let gs = ⍳ (n * n) ¨ (k => gcd(k div n + 1, k % n + 1))
    print("{gs ¨ (g => if g == 1 { 1 } else { 0 }) ▷ +/} {gs ▷ +/}")
}
