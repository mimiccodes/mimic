module main

// xxhash64: xxHash64 (seed 0) of 8 MiB of generated bytes: four lanes,
// each fed every fourth 64-bit word, then merged and mixed. One sequential
// pass over 32-byte stripes, a function that calls itself with the four
// lanes. Arithmetic wraps at 64 bits, as the algorithm wants. Checked
// against Python's `xxhash`.

fn p1() -> i64 { 0x9E3779B185EBCA87 }
fn p2() -> i64 { 0xC2B2AE3D27D4EB4F }
fn p3() -> i64 { 0x165667B19E3779F9 }
fn p4() -> i64 { 0x85EBCA77C2B2AE63 }

fn rotl(x: i64, r: i64) -> i64 { x << r | x >>> (64 - r) }

fn round(acc: i64, lane: i64) -> i64 { rotl(acc + lane * p2(), 31) * p1() }

fn merge(h: i64, v: i64) -> i64 { (h ^ round(0, v)) * p1() + p4() }

// the 64-bit word at p, little-endian
fn word(data: [u8], p: i64) -> i64 {
    data[p] | data[p + 1] << 8 | data[p + 2] << 16 | data[p + 3] << 24 | data[p + 4] << 32 | data[p + 5] << 40 | data[p + 6] << 48 | data[p + 7] << 56
}

// the four lanes after the stripes from p on
fn lanes(data: [u8], p: i64, v1: i64, v2: i64, v3: i64, v4: i64) -> (i64, i64, i64, i64) {
    if p == ≢ data { (v1, v2, v3, v4) }
    else { lanes(data, p + 32, round(v1, word(data, p)), round(v2, word(data, p + 8)), round(v3, word(data, p + 16)), round(v4, word(data, p + 24))) }
}

fn main() {
    let n = 1 << 23
    let data = bytes::from(⍳ n ¨ (i => (i * 2654435761 >> 13) & 255))
    let (v1, v2, v3, v4) = lanes(data, 0, p1() + p2(), p2(), 0, 0 - p1())
    let h0 = rotl(v1, 1) + rotl(v2, 7) + rotl(v3, 12) + rotl(v4, 18)
    let h1 = merge(merge(merge(merge(h0, v1), v2), v3), v4) + n
    let h2 = (h1 ^ h1 >>> 33) * p2()
    let h3 = (h2 ^ h2 >>> 29) * p3()
    let h = h3 ^ h3 >>> 32
    print(bytes::hex(bytes::from(⍳ 8 ¨ (i => h >>> (56 - i * 8) & 255))))
}
