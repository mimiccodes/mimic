module main

// brainf: an interpreter for Brainf**k running a program of three nested
// counting loops (120 × 120 × 121 passes of an inner loop that moves a
// cell into two others; cells wrap at 256): about 15.8 million
// instructions, one after another. Brackets are matched first; the run is
// a `settle` with a named step function, so the tape changes in place.
// Prints the instructions run and a checksum of the tape. The reference is
// bench/brainf/ref.py.

type M = { pc: i64, ptr: i64, steps: i64, tape: [i64] }

// for each bracket, where its partner is
fn partners(prog: [i64]) -> [i64] {
    let (_, _, jump) = (0, [], ⍳ ≢ prog ¨ (_ => 0)) ▷ settle(s => {
        let (i, open, jump) = s
        if prog[i] == 91 { (i + 1, push(open, i), jump) }
        else if prog[i] == 93 {
            let j = open[≢ open - 1]
            (i + 1, open ↓ ¯1, put(put(jump, i, j), j, i))
        } else { (i + 1, open, jump) }
    }, s => s.0 == ≢ prog)
    jump
}

fn step(m: M, prog: [i64], jump: [i64]) -> M {
    let c = prog[m.pc]
    if c == 43 { { m with pc: m.pc + 1, steps: m.steps + 1, tape: put(m.tape, m.ptr, (m.tape[m.ptr] + 1) % 256) } }
    else if c == 45 { { m with pc: m.pc + 1, steps: m.steps + 1, tape: put(m.tape, m.ptr, (m.tape[m.ptr] + 255) % 256) } }
    else if c == 62 { { m with pc: m.pc + 1, ptr: m.ptr + 1, steps: m.steps + 1 } }
    else if c == 60 { { m with pc: m.pc + 1, ptr: m.ptr - 1, steps: m.steps + 1 } }
    else if (c == 91 and m.tape[m.ptr] == 0) or (c == 93 and m.tape[m.ptr] != 0) { { m with pc: jump[m.pc] + 1, steps: m.steps + 1 } }
    else { { m with pc: m.pc + 1, steps: m.steps + 1 } }
}

fn main() {
    let text = repeat("+", 120) + "[>" + repeat("+", 120) + "[>" + repeat("+", 121) + "[>+>+<<-]<-]<-]"
    let prog = bytes::of_text(text) ¨ (b => b + 0)
    let jump = partners(prog)
    let m = M { pc: 0, ptr: 0, steps: 0, tape: ⍳ 16 ¨ (_ => 0) } ▷ settle(s => step(s, prog, jump), s => s.pc == ≢ prog)
    print("{m.steps} {+/ (⍳ 16 ¨ (i => (i + 1) * m.tape[i]))}")
}
