module main

// bsearch: 1,000,000 sorted keys (from splitmix64, then `sort`) and
// 4,000,000 lookups, each the lower bound by binary search (a function
// that calls itself on the half that holds it); every 16th asks for a key
// that is there. The lookups run in parallel. Prints the sum of the
// positions and how many lookups found their key. The reference is
// bench/bsearch/ref.py.

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

// the first position in keys[lo … hi) whose key is not below q
fn lower(keys: [i64], q: i64, lo: i64, hi: i64) -> i64 {
    if lo >= hi { lo } else {
        let mid = (lo + hi) div 2
        if keys[mid] < q { lower(keys, q, mid + 1, hi) } else { lower(keys, q, lo, mid) }
    }
}

// lookup j: every 16th a key that is there
fn query(keys: [i64], j: i64) -> i64 {
    if j % 16 == 0 { keys[(j div 16 * 7919) % ≢ keys] } else { mix(1000000000 + j) % 1000000000000 }
}

fn main() {
    let (n, m) = (1000000, 4000000)
    let keys: [i64] = sort(⍳ n ¨ (k => mix(k) % 1000000000000))
    let at = ⍳ m ¨ (j => lower(keys, query(keys, j), 0, n))
    let found = ⍳ m ¨ (j => if at[j] < n and keys[at[j] ⌊ (n - 1)] == query(keys, j) { 1 } else { 0 }) ▷ +/
    print("{at ▷ +/} {found}")
}
