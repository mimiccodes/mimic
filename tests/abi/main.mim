module main

trusted extern "C" include "abi.h"

fn main() {
    print(c::tiny_echo(c::Tiny { c: 64 }))
    print(c::pair_swap(c::PairF { a: 1.5, b: 2.5 }))
    print(c::quad_sum(c::QuadD { a: 1.0, b: 2.0, c: 3.0, d: 4.0 }))
    print(c::quad_scale(c::QuadD { a: 1.0, b: 2.0, c: 3.0, d: 4.0 }, 0.5))
    print(c::mixed_bump(c::Mixed { i: 41, d: 1.0 }))
    print(c::big_sum(c::big_make(100)))
    print(c::odd_echo(c::Odd { a: 1, b: 300, c: 5, d: 70000 }))
    print(c::nest_make(0.25, 0.75, 9, 1e10))
    let p = c::PairF { a: 1.0, b: 2.0 }
    let m = c::Mixed { i: 10, d: 0.5 }
    print(c::many(p, p, p, p, p, m, m, m, 100.0, 1000))
}
