module main

// For every n below 20,000,000 add up its digit sum, and count the n
// whose digits add up to 30.

fn digit_sum(n: i64) -> i64 {
    if n == 0 { 0 } else { n % 10 + digit_sum(n div 10) }
}

fn main() {
    let sums = ⍳ 20000000 ¨ digit_sum
    print(sums ▷ +/)
    print(count(sums, s => s == 30))
}
