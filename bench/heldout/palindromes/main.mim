module main

// Count the palindromic substrings of a generated 10,000,000-letter
// string over "ab" by expanding around each centre.

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn make_letters(n: i64, x: i64, acc: [str]) -> [str] {
    if n == 0 { acc } else {
        let y = next(x)
        let letter = if (y div 65536) % 2 == 0 { "a" } else { "b" }
        make_letters(n - 1, y, push(acc, letter))
    }
}

// how many palindromes grow out of the centre l, r
fn expand(cs: [str], l: i64, r: i64, found: i64) -> i64 {
    if l >= 0 and r < ≢ cs and cs[l] == cs[r] {
        expand(cs, l - 1, r + 1, found + 1)
    } else {
        found
    }
}

fn main() {
    let s = make_letters(10000000, 42, []) ▷ join("")
    let cs = chars(s)
    let total = ⍳ (≢ cs) ¨ (c => expand(cs, c, c, 0) + expand(cs, c, c + 1, 0)) ▷ +/
    print(total)
}
