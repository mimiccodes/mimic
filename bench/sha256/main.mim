module main

// sha256: the SHA-256 digest (FIPS 180-4) of 2 MiB of generated bytes.
// Blocks of 64 bytes one after another (each starts from the last one's
// state); in a block, the 64-word message schedule, then 64 rounds over
// the eight working words.

fn k() -> [i64] {
    [0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5
     0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174
     0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da
     0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967
     0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85
     0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070
     0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3
     0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2]
}

fn rotr(x: i64, n: i64) -> i64 { (x >>> n | x << (32 - n)) & 0xFFFFFFFF }

// the message schedule of the block at `off`: 16 words read big-endian,
// then 48 more from them
fn schedule(data: [i64], off: i64) -> [i64] {
    let first = ⍳ 16 ¨ (j => {
        let p = off + j * 4
        data[p] << 24 | data[p + 1] << 16 | data[p + 2] << 8 | data[p + 3]
    })
    first ▷ evolve(48, w => {
        let j = ≢ w
        let a = w[j - 15]
        let b = w[j - 2]
        let s0 = rotr(a, 7) ^ rotr(a, 18) ^ a >>> 3
        let s1 = rotr(b, 17) ^ rotr(b, 19) ^ b >>> 10
        push(w, (w[j - 16] + s0 + w[j - 7] + s1) & 0xFFFFFFFF)
    })
}

// one round on the working words [a b c d e f g h]
fn round(v: [i64], kw: i64) -> [i64] {
    let e = v[4]
    let a = v[0]
    let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
    let ch = e & v[5] ^ ~e & v[6]
    let t1 = (v[7] + s1 + ch + kw) & 0xFFFFFFFF
    let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
    let maj = a & v[1] ^ a & v[2] ^ v[1] & v[2]
    [(t1 + s0 + maj) & 0xFFFFFFFF, a, v[1], v[2], (v[3] + t1) & 0xFFFFFFFF, e, v[5], v[6]]
}

fn block(h: [i64], data: [i64], off: i64, ks: [i64]) -> [i64] {
    let w = schedule(data, off)
    let (_, v) = (0, h) ▷ settle(s => (s.0 + 1, round(s.1, (ks[s.0] + w[s.0]) & 0xFFFFFFFF)), s => s.0 == 64)
    ⍳ 8 ¨ (i => (h[i] + v[i]) & 0xFFFFFFFF)
}

fn main() {
    let n = 1 << 21
    let data = ⍳ n ¨ (i => (i * 2654435761 >> 13) & 255)
    // the padding: 0x80, zeros, and the length in bits (big-endian); the
    // data is whole blocks, so the padding is one more block
    let bits = n * 8
    let pad = concat(concat([128], ⍳ 55 ¨ (_ => 0)), ⍳ 8 ¨ (i => bits >> (56 - i * 8) & 255))
    let msg = concat(data, pad)
    let ks = k()
    let h0 = [0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19]
    let blocks = ≢ msg div 64
    let (_, h) = (0, h0) ▷ settle(s => (s.0 + 1, block(s.1, msg, s.0 * 64, ks)), s => s.0 == blocks)
    print(bytes::hex(bytes::from(⍳ 32 ¨ (i => h[i div 4] >> (24 - i % 4 * 8) & 255))))
}
