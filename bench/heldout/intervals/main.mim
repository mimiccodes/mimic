module main

// Sorts 1,000,000 generated intervals by start and merges the overlapping
// ones; prints how many merged intervals remain and their total length.

type Interval = { start: i64, end: i64 }

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn generate(n: i64, x: i64, acc: [Interval]) -> [Interval] {
    if n == 0 {
        acc
    } else {
        let x1 = next(x)
        let x2 = next(x1)
        let start = x1 % 1000000000
        generate(n - 1, x2, push(acc, Interval { start: start, end: start + x2 % 1000 + 1 }))
    }
}

fn merge_all(ivs: [Interval], i: i64, cur: Interval, merged: i64, covered: i64) -> (i64, i64) {
    if i == ≢ ivs {
        (merged + 1, covered + cur.end - cur.start)
    } else if ivs[i].start <= cur.end {
        merge_all(ivs, i + 1, { cur with end: max(cur.end, ivs[i].end) }, merged, covered)
    } else {
        merge_all(ivs, i + 1, ivs[i], merged + 1, covered + cur.end - cur.start)
    }
}

fn main() {
    let intervals = generate(1000000, 42, [])
    let sorted = sort_by(intervals, iv => iv.start)
    let (merged, covered) = merge_all(sorted, 1, sorted[0], 0, 0)
    print(merged)
    print(covered)
}
