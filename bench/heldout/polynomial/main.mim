module main

// Multiplies 2,000 pairs of generated polynomials of degree 300 (lists of
// integer coefficients from -100 to 100) and prints a checksum of all the
// product coefficients.

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn random_poly(n: i64, x: i64, coeffs: [i64]) -> ([i64], i64) {
    if n == 0 {
        (coeffs, x)
    } else {
        let y = next(x)
        random_poly(n - 1, y, push(coeffs, y % 201 - 100))
    }
}

// coefficient k of the product sums a[i] * b[k - i]
fn multiply(a: [i64], b: [i64]) -> [i64] {
    let n = ≢ a
    let m = ≢ b
    ⍳ (n + m - 1) ¨ (k => {
        let lo = max(0, k - (m - 1))
        let hi = min(k, n - 1)
        lo ‥ (hi + 1) ¨ (i => a[i] * b[k - i]) ▷ +/
    })
}

fn checksum(c: [i64]) -> i64 {
    let idx = ⍳ (≢ c)
    c * (idx + 1) ▷ +/
}

fn run(pairs: i64, x: i64, total: i64) -> i64 {
    if pairs == 0 {
        total
    } else {
        let (a, x1) = random_poly(301, x, [])
        let (b, x2) = random_poly(301, x1, [])
        run(pairs - 1, x2, total + checksum(multiply(a, b)))
    }
}

fn main() {
    print(run(2000, 42, 0))
}
