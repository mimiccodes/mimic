module main

// bigmul: the product of two 120,000-digit numbers (30,000 limbs of four
// decimal digits, from splitmix64), by schoolbook multiplication: each
// limb of the product is a sum of products of limbs, independent of the
// others, so `¨` computes them in parallel; then carries move up in
// parallel passes until every limb is below 10,000. Prints the product's
// limbs, their sum, the top limb and the middle one. The reference is
// bench/bigmul/ref.py (Python's own big integers).

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

fn limb(seed: i64, i: i64, n: i64) -> i64 {
    if i == n - 1 { 1 + mix(seed + i) % 9999 } else { mix(seed + i) % 10000 }
}

// limb k of the product, before carrying
fn column(a: [i64], b: [i64], k: i64) -> i64 {
    let n = ≢ a
    let lo = if k < n { 0 } else { k - n + 1 }
    let hi = if k < n { k + 1 } else { n }
    range(lo, hi) ¨ (i => a[i] * b[k - i]) ▷ +/
}

fn carry(c: [i64]) -> [i64] {
    ⍳ ≢ c ¨ (k => c[k] % 10000 + if k > 0 { c[k - 1] div 10000 } else { 0 })
}

fn main() {
    let n = 30000
    let a = ⍳ n ¨ (i => limb(0, i, n))
    let b = ⍳ n ¨ (i => limb(n, i, n))
    let c = ⍳ (2 * n) ¨ (k => if k < 2 * n - 1 { column(a, b, k) } else { 0 }) ▷ settle(carry, c => ⌈/ c < 10000)
    let size = if c[2 * n - 1] == 0 { 2 * n - 1 } else { 2 * n }
    print("{size} {+/ c} {c[size - 1]} {c[n]}")
}
