module main

// Pure functions compile to interaction nets: independent calls run in
// parallel automatically, with no annotations.
fn main() {
    print(fib(25))
    print(tri(100000))              // 100k-deep recursion: the net takes over from the stack
    print(ackermann(2, 300))
    print(gcd(1071, 462))
    print(classify(7) + classify(¯7) + classify(0))
    print(mean_of_squares(⍳ 1000))  // arrays flow through the net
    print([3 5 8] ¨ fib)            // ¨ calls the native body, in parallel
    print(pick([10 20 30], 1))
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn tri(n: i64) -> i64 {
    if n == 0 { 0 } else { n + tri(n - 1) }
}

fn ackermann(m: i64, n: i64) -> i64 {
    if m == 0 {
        return n + 1
    }
    if n == 0 {
        return ackermann(m - 1, 1)
    }
    ackermann(m - 1, ackermann(m, n - 1))
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn classify(n: i64) -> i64 {
    let big = n > 5
    if big { 100 } else if n < 0 { 10 } else { 1 }
}

fn mean_of_squares(xs: [i64]) -> f64 {
    let sq = xs × xs
    (sq ▷ +/) ÷ (sq ▷ ≢)
}

fn pick(xs: [i64], i: i64) -> i64 { xs[i] }
