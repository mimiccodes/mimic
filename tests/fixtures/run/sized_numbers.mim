module main

// f32 and i32: 4 bytes a number; f32 arithmetic rounds to f32, i32
// arithmetic wraps; a list keeps its type against a single value

type Sample = { name: str, weight: f32, count: i32 }

fn half(x: f32) -> f32 { x * 0.5 }

fn main() {
    let a: f32 = 0.1
    print(a + a + a)
    print(half(3))
    let xs: [f32] = ⍳ 5 * 0.1
    print(xs)
    print(xs * 2)
    print(xs ▷ +/)
    print(xs + [1 2 3 4 5])
    let ys: [i32] = [1 2 3 2147483647]
    print(ys + 1)
    print(ys ▷ +/)
    print(ys * 2.5)
    let n: i32 = 7
    print(n div 2)
    print(n / 2)
    print(json::encode(xs))
    print(xs == xs)
    let s = Sample { name: "s", weight: 1.25, count: 3 }
    print(s)
    print(s.weight * 2)
    print(⌽ xs ↓ 1)
    let m = [n: "seven"]
    print(m[7])
}
