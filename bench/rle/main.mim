module main

// rle: run-length encoding of 8 MiB of generated bytes with runs of 1 to
// 16, as (length, byte) pairs with lengths up to 255, then decoded and
// compared. Written over whole arrays: where runs start, their lengths,
// then `⌿` (replicate) to decode. Prints the encoded size, the sum of
// the encoded bytes and 1 when the decoded bytes equal the original.

fn mix(b: i64) -> i64 { b * 2654435761 >> 13 }

// blocks of 16: one byte, then another from a point inside the block;
// neighbouring blocks never share a byte, so runs are at most 16 long
fn byte(i: i64) -> i64 {
    let b = i div 16
    let v = 8 * (b & 1) + (mix(b) & 3)
    if i % 16 < mix(b + 7) % 16 + 1 { v } else { v + 4 }
}

// a run as pairs of at most 255
fn pairs(count: i64, v: i64) -> [i64] {
    flatten(⍳ ((count + 254) div 255) ¨ (k => [count - k * 255 ⌊ 255, v]))
}

fn main() {
    let n = 1 << 23
    let data = ⍳ n ¨ byte
    let starts = ⍳ n ⌿ (⍳ n ¨ (i => i == 0 or data[i] != data[i - 1]))
    let lens = push(starts ↓ 1, n) - starts
    let encoded = flatten(⍳ ≢ starts ¨ (r => pairs(lens[r], data[starts[r]])))
    let half = ⍳ (≢ encoded div 2)
    let decoded = (half ¨ (j => encoded[2 * j + 1])) ⌿ (half ¨ (j => encoded[2 * j]))
    let same = if ≢ decoded == n and +/ (decoded != data) == 0 { 1 } else { 0 }
    print("{≢ encoded} {+/ encoded} {same}")
}
