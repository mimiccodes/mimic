module main

// `[]` typed by the branch next to it is one shared empty list: changing
// what it gave (push, put back into a record, concat) never changes the
// `[]` of a later call; `concat(s.out, [])` leaves the list as it is

type S = { n: i64, out: [i64] }

fn flush(run: i64) -> [i64] { if run > 0 { [192 | run - 1] } else { [] } }

fn step(s: S) -> S {
    let f = flush(s.n % 3)
    { s with n: s.n + 1, out: concat(s.out, f) }
}

fn main() {
    let a = flush(0)
    let b = push(a, 5)
    let c = flush(0)
    let mut d = flush(0)
    d = push(d, 9)
    d = push(d, 10)
    print("{a} {b} {c} {d} {flush(0)}")
    let s = S { n: 0, out: [] } ▷ evolve(10, step)
    print("{s.n} {s.out} {≢ s.out}")
    let t = S { n: 0, out: flush(0) } ▷ evolve(4, step)
    print("{t.out} {flush(0)} {≢ flush(0)}")
    let fs = ⍳ 3 ¨ (k => flush(0))
    print("{fs} {concat(concat(fs[0], fs[1]), [1])} {fs[2]}")
}
