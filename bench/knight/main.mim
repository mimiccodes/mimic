module main

// knight: the number of knight's tours (open or closed) on a 5 × 5 board
// from each square, by backtracking over the eight moves in a fixed order
// with the visited squares as a bitmask: a function of plain numbers that
// calls itself, the 25 starting squares searched in parallel. A search
// gives back one number: the moves it tried × 2^21 + the tours it found.
// Prints the total number of tours (1,728), the number from a corner (304),
// and the number of moves tried. The reference is bench/knight/ref.py.

fn n() -> i64 { 5 }
fn shift() -> i64 { 21 }

// the search from (x, y) with `mask` visited and `depth` squares done
fn tours(x: i64, y: i64, mask: i64, depth: i64) -> i64 {
    if depth == n() * n() { 1 } else { (8 << shift()) + moves(x, y, mask, depth, 0, 0) }
}

// the searches after moves k … 7
fn moves(x: i64, y: i64, mask: i64, depth: i64, k: i64, t: i64) -> i64 {
    if k == 8 { t } else {
        let nx = x + (if k == 0 or k == 3 { 1 } else if k == 1 or k == 2 { 2 } else if k == 4 or k == 7 { ¯1 } else { ¯2 })
        let ny = y + (if k == 0 or k == 7 { 2 } else if k == 1 or k == 6 { 1 } else if k == 2 or k == 5 { ¯1 } else { ¯2 })
        let free = nx >= 0 and ny >= 0 and nx < n() and ny < n() and mask >>> (ny * n() + nx) & 1 == 0
        let more = if free { tours(nx, ny, mask | 1 << (ny * n() + nx), depth + 1) } else { 0 }
        moves(x, y, mask, depth, k + 1, t + more)
    }
}

fn main() {
    let found = ⍳ (n() * n()) ¨ (s => tours(s % n(), s div n(), 1 << s, 1))
    let counts = found ¨ (f => f & ((1 << shift()) - 1))
    print("{counts ▷ +/} {counts[0]} {found ¨ (f => f >>> shift()) ▷ +/}")
}
