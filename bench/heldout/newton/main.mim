module main

// Square roots of 3,000,000 generated numbers by Newton's method, each
// iterated until |g² - v| < 1e-12 · v, then summed.

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn generate(n: i64, x: i64, acc: [i64]) -> [i64] {
    if n == 0 { acc } else {
        let y = next(x)
        generate(n - 1, y, push(acc, y % 1000000 + 1))
    }
}

fn newton_sqrt(v: f64) -> f64 {
    v ▷ settle(g => (g + v / g) / 2.0, g => ∣(g * g - v) < 1e-12 * v)
}

fn main() {
    let values = generate(3000000, 42, [])
    let total = values ¨ (v => newton_sqrt(v * 1.0)) ▷ +/
    print("{total:.2}")
}
