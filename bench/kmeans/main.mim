module main

// kmeans: 1,000,000 points (whole-number coordinates up to 100,000, from
// splitmix64) put into 16 clusters by Lloyd's algorithm, 25 rounds: each
// point goes to its nearest centre (the first, on a tie), then each centre
// moves to the mean of its points (rounded down; a centre with no points
// stays). Points are independent, so the nearest centres and the sums are
// parallel, and in whole numbers, so they do not depend on order. Prints
// the sum of the centres' coordinates, the points of the first cluster and
// the total squared distance to the nearest centre. The reference is
// bench/kmeans/ref.py.

// the centres' coordinates
type C = { x: [i64], y: [i64] }

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

fn dist(cx: [i64], cy: [i64], j: i64, x: i64, y: i64) -> i64 {
    let (dx, dy) = (cx[j] - x, cy[j] - y)
    dx * dx + dy * dy
}

// the nearest of centres j… to (x, y), given the best so far
fn nearest(cx: [i64], cy: [i64], x: i64, y: i64, j: i64, best: i64, at: i64) -> i64 {
    if j == ≢ cx { at }
    else {
        let d = dist(cx, cy, j, x, y)
        if d < best { nearest(cx, cy, x, y, j + 1, d, j) } else { nearest(cx, cy, x, y, j + 1, best, at) }
    }
}

// the centres' lists are taken out of the record before `¨`: a record
// used inside `¨` is retained and released for every element (docs/gaps.md)
fn round(c: C, xs: [i64], ys: [i64]) -> C {
    let (cx, cy) = (c.x, c.y)
    let near = ⍳ ≢ xs ¨ (i => nearest(cx, cy, xs[i], ys[i], 0, 0x7FFFFFFFFFFFFFFF, 0))
    let k = ≢ cx
    let counts = ⍳ k ¨ (j => near ¨ (a => if a == j { 1 } else { 0 }) ▷ +/)
    let sx = ⍳ k ¨ (j => xs ⌿ (near == j) ▷ +/)
    let sy = ⍳ k ¨ (j => ys ⌿ (near == j) ▷ +/)
    C { x: ⍳ k ¨ (j => if counts[j] == 0 { cx[j] } else { sx[j] div counts[j] }), y: ⍳ k ¨ (j => if counts[j] == 0 { cy[j] } else { sy[j] div counts[j] }) }
}

fn main() {
    let (n, k) = (1000000, 16)
    let xs = ⍳ n ¨ (i => mix(2 * i) % 100001)
    let ys = ⍳ n ¨ (i => mix(2 * i + 1) % 100001)
    let c = C { x: xs ↑ k, y: ys ↑ k } ▷ evolve(25, c => round(c, xs, ys))
    let (cx, cy) = (c.x, c.y)
    let near = ⍳ n ¨ (i => nearest(cx, cy, xs[i], ys[i], 0, 0x7FFFFFFFFFFFFFFF, 0))
    let first = near ¨ (a => if a == 0 { 1 } else { 0 }) ▷ +/
    let spread = ⍳ n ¨ (i => dist(cx, cy, near[i], xs[i], ys[i])) ▷ +/
    print("{+/ cx + +/ cy} {first} {spread}")
}
