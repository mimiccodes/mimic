module main

// randwalk: 200,000 walkers, each taking 1,000 steps on the square lattice
// from (0, 0) in directions from splitmix64. Each walker is a function
// that calls itself, step after step; the walkers walk in parallel. Prints
// the sum of the squared distances at the end, the largest, and how many
// walkers end where they started. The reference is bench/randwalk/ref.py.

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

// walker w from step t at (x, y): its squared distance at the end
fn walk(w: i64, t: i64, x: i64, y: i64) -> i64 {
    if t == 1000 { x * x + y * y } else {
        let d = mix(1000 * w + t) % 4
        walk(w, t + 1, x + (if d == 0 { 1 } else if d == 2 { ¯1 } else { 0 }), y + (if d == 1 { 1 } else if d == 3 { ¯1 } else { 0 }))
    }
}

fn main() {
    let r2 = ⍳ 200000 ¨ (w => walk(w, 0, 0, 0))
    print("{r2 ▷ +/} {r2 ▷ ⌈/} {r2 ¨ (r => if r == 0 { 1 } else { 0 }) ▷ +/}")
}
