module main

// Program basics: arguments, environment, files, directories, paths, stdin.
// (The test harness gives every run its own temporary directory.)
fn main() {
    print(os::args())                                   // no arguments here
    let dir = path::join(fs::temp_dir(), "mimic-files")
    print(fs::make_dir(path::join(dir, "sub/deeper")))
    let f = path::join(dir, "notes.txt")
    print(fs::write(f, "one\ntwo\n"))
    print(fs::append(f, "three\n"))
    let text = fs::read(f) else { return }
    print(lines(text))
    print(fs::size(f))
    print(fs::copy(f, path::join(dir, "copy.txt")))
    print(fs::rename(path::join(dir, "copy.txt"), path::join(dir, "moved.txt")))
    print(fs::list_dir(dir))
    print((fs::exists(f), fs::is_file(f), fs::is_dir(dir), fs::is_dir(f), fs::exists(path::join(dir, "nope"))))
    match fs::read(path::join(dir, "nope")) {
        Ok(_) => print("unexpected"),
        Err(e) => print(contains(e, "cannot read")),
    }
    print(word_count(f))
    print(fs::remove(path::join(dir, "moved.txt")))
    print(fs::remove(f))
    print(is_ok(fs::remove(dir)))                  // not empty yet: fails
    print(fs::remove(path::join(dir, "sub/deeper")))
    print(fs::remove(path::join(dir, "sub")))
    print(fs::remove(dir))
    print(fs::exists(dir))
    print(os::env("MIMIC_SURELY_UNSET_VARIABLE"))
    print(os::set_env("MIMIC_FILES_TEST", "set"))
    print(os::env("MIMIC_FILES_TEST"))
    print((path::file_name("a/b/c.tar.gz"), path::extension("a/b/c.tar.gz"), path::stem("a/report.pdf"), path::parent("a/b/c.txt"), path::parent("c.txt")))
    print(path::join("/x", "/abs"))
    print(io::read_line())                              // stdin is empty here
    print(lines("a\r\nb\n"))
}

fn is_ok(r: Result[bool, str]) -> bool {
    match r {
        Ok(_) => true,
        Err(_) => false,
    }
}

// a function that reads a file is not pure: it runs in program order
fn word_count(path: str) -> i64 {
    let text = fs::read(path) else { return 0 }
    ≢ lines(text)
}
