module main

fn main() {
    // integer division is floored, like %: (a div b) × b + a % b == a
    print(7 div 2)
    print(¯7 div 2)
    print(7 ⫽ ¯2)
    print(7.5 div 2)
    print(⍳ 10 div 3)
    print(check(¯7, 2) ∧ check(7, ¯3) ∧ check(¯9, ¯4))

    // range
    print(range(3, 8))
    print(3 ‥ 8 ▷ +/)
    print(5 ‥ 2)

    // max / min / abs, scalar and elementwise
    print(max(3, 9) + min(3, 9))
    print(4 ⌈ 7 ⌊ 5)
    print([1 8 3] ⌈ [6 2 4])
    print(abs(¯5) + ∣ 2)
    print(∣ [¯1.5 2 ¯3])
    print([3 1 4 1 5] ⌈/)

    // all of it inside pure recursive functions (compiled to nets)
    print(digits(9876543210))
    print(collatz(27))
    print(gcd(1071, 462))
}

fn check(a: i64, b: i64) -> bool { (a div b) × b + a % b == a }

fn digits(n: i64) -> i64 {
    if n < 10 { 1 } else { 1 + digits(n div 10) }
}

// steps for the Collatz sequence of n to reach 1
fn collatz(n: i64) -> i64 {
    if n == 1 { 0 } else if n % 2 == 0 { 1 + collatz(n div 2) } else { 1 + collatz(3 × n + 1) }
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { abs(a) } else { gcd(b, a % b) }
}
