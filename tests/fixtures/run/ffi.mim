module main

trusted extern "C" {
    fn sqrt(x: f64) -> f64
    fn abs(x: i32) -> i32
}

extern "C" {
    fn strlen(s: cstr) -> usize
}

fn main() {
    print(c::sqrt(16.0))
    print(c::abs(¯42))      // the C function; plain `abs` is the built-in
    print(unsafe { c::strlen("mimic") })
    print([1.0 4.0 9.0] ¨ root)
}

fn root(x: f64) -> f64 { c::sqrt(x) }
