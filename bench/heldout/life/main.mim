module main

// Conway's Game of Life on a 300 x 300 grid held as a list of rows
// (cells outside the grid are dead), run for 300 generations; prints
// the number of live cells at the end.

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn random_row(n: i64, x: i64, row: [i64]) -> ([i64], i64) {
    if n == 0 {
        (row, x)
    } else {
        let y = next(x)
        let alive = if y % 3 == 0 { 1 } else { 0 }
        random_row(n - 1, y, push(row, alive))
    }
}

fn random_grid(rows: i64, cols: i64, x: i64, grid: [[i64]]) -> [[i64]] {
    if rows == 0 {
        grid
    } else {
        let (row, y) = random_row(cols, x, [])
        random_grid(rows - 1, cols, y, push(grid, row))
    }
}

fn cell(grid: [[i64]], r: i64, c: i64) -> i64 {
    let n = ≢ grid
    if r >= 0 and r < n and c >= 0 and c < n { grid[r][c] } else { 0 }
}

fn neighbours(grid: [[i64]], r: i64, c: i64) -> i64 {
    let above = cell(grid, r - 1, c - 1) + cell(grid, r - 1, c) + cell(grid, r - 1, c + 1)
    let beside = cell(grid, r, c - 1) + cell(grid, r, c + 1)
    let below = cell(grid, r + 1, c - 1) + cell(grid, r + 1, c) + cell(grid, r + 1, c + 1)
    above + beside + below
}

fn step(grid: [[i64]]) -> [[i64]] {
    let n = ≢ grid
    ⍳ n ¨ (r => ⍳ n ¨ (c => {
        let k = neighbours(grid, r, c)
        if grid[r][c] == 1 {
            if k == 2 or k == 3 { 1 } else { 0 }
        } else {
            if k == 3 { 1 } else { 0 }
        }
    }))
}

fn main() {
    let grid = random_grid(300, 300, 42, [])
    let last = grid ▷ evolve(300, step)
    print(last ¨ (row => row ▷ +/) ▷ +/)
}
