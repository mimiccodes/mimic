module main

// `and` and `or` where a side's type is known only when the program runs
// (parameters without types, a list from `flatten`): the right side runs
// only when it decides, as with known truth values, and lists still go
// element by element

fn pick(xs, i, j, c) {
    if j == c or (i < 2 and xs[i] <= xs[j]) { 1 } else { 2 }
}

fn first_big(xs, j) {
    if j == ≢ xs or xs[j] > 0 { 1 } else { 2 }
}

fn both(a, b) { a and b }
fn either(a, b) { a or b }

fn main() {
    let xs = flatten([[0 5] [10]])
    print(first_big(xs, 3))
    print(first_big(xs, 0))
    print(pick(xs, 0, 3, 3))
    print(pick(xs, 0, 1, 3))
    print(pick(xs, 2, 1, 3))
    print(both(true, false))
    print(either(false, true))
    print(both([true false true], [true true false]))
    print(either([true false], false))
}
