module main

// fnv1a: the 64-bit FNV-1a hash of 8 MiB of generated bytes: xor in a
// byte, multiply by the FNV prime (wrapping), one sequential pass.

fn main() {
    let n = 1 << 23
    let data = ⍳ n ¨ (i => (i * 2654435761 >> 13) & 255)
    let (_, h) = (0, 0xcbf29ce484222325) ▷ settle(s => (s.0 + 1, (s.1 ^ data[s.0]) * 0x100000001b3), s => s.0 == n)
    print(h)
}
