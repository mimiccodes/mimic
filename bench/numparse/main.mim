module main

// numparse: 2,000,000 signed integers of 1 to 16 digits (from splitmix64)
// written one a line into one text, then read back: split into lines and
// each parsed with `to_int`, in parallel. Prints the sum, the number of
// negatives, the largest and the smallest. The reference is
// bench/numparse/ref.py.

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

// 10 to the power d
fn pow10(d: i64) -> i64 { ⍳ d ¨ (_ => 10) ▷ ×/ }

fn value(i: i64) -> i64 {
    let v = mix(i) % pow10(1 + mix(i + 10000000) % 16)
    if mix(i + 20000000) % 2 == 1 { 0 - v } else { v }
}

fn main() {
    let text = join(⍳ 2000000 ¨ (i => string(value(i))), "\n")
    let xs = lines(text) ¨ to_int
    let negatives = xs ¨ (x => if x < 0 { 1 } else { 0 }) ▷ +/
    print("{xs ▷ +/} {negatives} {xs ▷ ⌈/} {xs ▷ ⌊/}")
}
