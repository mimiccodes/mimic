module main

// Topological order of a generated DAG of 400,000 nodes and 1,200,000
// edges (every edge goes from a smaller to a larger node); prints the
// number of nodes in the order and a checksum of it.

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn make_edges(count: i64, n: i64, x: i64, from: [i64], to: [i64]) -> ([i64], [i64]) {
    if count == 0 {
        (from, to)
    } else {
        let x1 = next(x)
        let u = x1 % (n - 1)
        let x2 = next(x1)
        let v = u + 1 + x2 % (n - 1 - u)
        make_edges(count - 1, n, x2, push(from, u), push(to, v))
    }
}

fn main() {
    let n = 400000
    let (from, to) = make_edges(1200000, n, 42, [], [])
    match graph::topo(n, from, to) {
        Some(order) => {
            let idx = ⍳ (≢ order)
            print(≢ order)
            print(order * (idx % 1000 + 1) ▷ +/)
        },
        None => print("cycle"),
    }
}
