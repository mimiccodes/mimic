module main

// `v[i] = x` on a `let mut` list of numbers: written in place where the
// list is held once (a loop that hands it on: no copy, no reference counted
// per step); a list still held elsewhere is copied first, so the other
// holder sees no change

fn bump(n: i64, counts: [i64]) -> [i64] {
    if n == 0 {
        counts
    } else {
        let mut c = counts
        c[n % 5] = c[n % 5] + n
        bump(n - 1, c)
    }
}

// the original is read after the copy is changed
fn changed(xs: [i64]) -> ([i64], [i64]) {
    let mut v = xs
    v[0] = v[0] + 100
    v[2] = v[1] * 2
    (xs, v)
}

// changed in a branch, then handed on
fn branchy(n: i64, acc: [i64]) -> [i64] {
    if n == 0 {
        acc
    } else {
        let mut a = acc
        if n % 2 == 0 {
            a[0] = a[0] + 1
        } else {
            a[1] = a[1] + 1
        }
        branchy(n - 1, a)
    }
}

fn main() {
    print(bump(100000, 0 ⥊ [5]))
    let base = [1 2 3]
    let (before, after) = changed(base)
    print("{before} {after} {base}")
    print(branchy(1001, [0 0]))
    // the same list given twice: each change is to its own copy
    let shared = [5 5 5]
    let (a, b) = changed(shared)
    let (c, d) = changed(shared)
    print("{a} {b} {c} {d} {shared}")
}
