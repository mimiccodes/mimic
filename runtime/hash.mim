// Hashes and checksums of bytes: hash::crc32(data), hash::xxhash64(data),
// hash::sha256(data) (a digest as bytes: bytes::hex(…) shows it). Each is the
// standard algorithm, checked against the usual references; the same code is
// measured by the benchmark corpus (bench/crc32, bench/xxhash64, …). Not for
// passwords or signatures: these are checksums and fast hashes, and md5 and
// sha1 are broken for security. (Appended to the prelude.)
pub module hash {
    // ---- checksums ----

    // CRC-32 (IEEE 802.3, as zlib and PNG use it): reflected polynomial
    // 0xEDB88320, initial value and final xor all ones.
    pub fn crc32(data: [u8]) -> i64 {
        let t = crc32_table()
        (Acc { i: 0, h: 0xFFFFFFFF, b: 0 } ▷ evolve(chunks(data), a => crc_chunk(a, data, t))).h ^ 0xFFFFFFFF
    }

    // CRC-64/XZ (as xz uses it): reflected polynomial 0xC96C5795D7870F42,
    // initial value and final xor all ones. A 64-bit result, so it may be
    // negative as an i64.
    pub fn crc64(data: [u8]) -> i64 {
        let t = crc64_table()
        (Acc { i: 0, h: ¯1, b: 0 } ▷ evolve(chunks(data), a => crc_chunk(a, data, t))).h ^ ¯1
    }

    // Adler-32 (as zlib uses it).
    pub fn adler32(data: [u8]) -> i64 {
        let a = Acc { i: 0, h: 1, b: 0 } ▷ evolve(≢ data, a => adler_step(a, data))
        (a.b % 65521) << 16 | a.h % 65521
    }

    // FNV-1a with 32 bits.
    pub fn fnv1a32(data: [u8]) -> i64 { (Acc { i: 0, h: 0x811C9DC5, b: 0 } ▷ evolve(chunks(data), a => fnv32_chunk(a, data))).h }

    // FNV-1a with 64 bits (may be negative as an i64).
    pub fn fnv1a64(data: [u8]) -> i64 { (Acc { i: 0, h: 0xCBF29CE484222325, b: 0 } ▷ evolve(chunks(data), a => fnv64_chunk(a, data))).h }

    // ---- fast hashes ----

    // MurmurHash3 x86_32.
    pub fn murmur3(data: [u8], seed: i64 = 0) -> i64 {
        let n = ≢ data
        let body = (Acc { i: 0, h: seed & 0xFFFFFFFF, b: 0 } ▷ evolve(n div 4, a => murmur_step(a, data))).h
        let tail = n - n % 4
        let k = (if n % 4 >= 3 { data[tail + 2] << 16 } else { 0 }) ^ (if n % 4 >= 2 { data[tail + 1] << 8 } else { 0 }) ^ (if n % 4 >= 1 { data[tail] } else { 0 })
        let h = if n % 4 == 0 { body } else { body ^ (rotl32((k * 0xCC9E2D51) & 0xFFFFFFFF, 15) * 0x1B873593 & 0xFFFFFFFF) }
        fmix32(h ^ n)
    }

    // xxHash32.
    pub fn xxhash32(data: [u8], seed: i64 = 0) -> i64 {
        let n = ≢ data
        let s = seed & 0xFFFFFFFF
        let stripes = n div 16
        let lanes = X32 { p: 0, v1: (s + 2654435761 + 2246822519) & 0xFFFFFFFF, v2: (s + 2246822519) & 0xFFFFFFFF, v3: s, v4: (s - 2654435761) & 0xFFFFFFFF } ▷ evolve(stripes, x => x32_stripe(x, data))
        let h0 = if n >= 16 { (rotl32(lanes.v1, 1) + rotl32(lanes.v2, 7) + rotl32(lanes.v3, 12) + rotl32(lanes.v4, 18)) & 0xFFFFFFFF } else { (s + 374761393) & 0xFFFFFFFF }
        let words = Acc { i: 16 * stripes, h: (h0 + n) & 0xFFFFFFFF, b: 0 } ▷ evolve((n - 16 * stripes) div 4, a => x32_word(a, data))
        let h1 = (words ▷ evolve(n % 4, a => x32_byte(a, data))).h
        let h2 = ((h1 ^ h1 >>> 15) * 2246822519) & 0xFFFFFFFF
        let h3 = ((h2 ^ h2 >>> 13) * 3266489917) & 0xFFFFFFFF
        h3 ^ h3 >>> 16
    }

    // xxHash64 (may be negative as an i64).
    pub fn xxhash64(data: [u8], seed: i64 = 0) -> i64 {
        let n = ≢ data
        let stripes = n div 32
        let lanes = X64 { p: 0, v1: seed + x64p1() + x64p2(), v2: seed + x64p2(), v3: seed, v4: seed - x64p1() } ▷ evolve(stripes, x => x64_stripe(x, data))
        let h0 = if n >= 32 {
            let h = rotl64(lanes.v1, 1) + rotl64(lanes.v2, 7) + rotl64(lanes.v3, 12) + rotl64(lanes.v4, 18)
            x64_merge(x64_merge(x64_merge(x64_merge(h, lanes.v1), lanes.v2), lanes.v3), lanes.v4)
        } else { seed + 0x27D4EB2F165667C5 }
        let words = Acc { i: 32 * stripes, h: h0 + n, b: 0 } ▷ evolve((n - 32 * stripes) div 8, a => x64_word(a, data))
        let half = if n - words.i >= 4 { x64_half(words, data) } else { words }
        let h1 = (half ▷ evolve(n - half.i, a => x64_byte(a, data))).h
        let h2 = (h1 ^ h1 >>> 33) * x64p2()
        let h3 = (h2 ^ h2 >>> 29) * 0x165667B19E3779F9
        h3 ^ h3 >>> 32
    }

    // SipHash-2-4 with the 128-bit key (k0, k1), as hash tables use it to
    // keep their buckets safe from chosen keys (may be negative as an i64).
    pub fn siphash(data: [u8], k0: i64, k1: i64) -> i64 {
        let n = ≢ data
        let start = Sip { p: 0, v0: k0 ^ 0x736F6D6570736575, v1: k1 ^ 0x646F72616E646F6D, v2: k0 ^ 0x6C7967656E657261, v3: k1 ^ 0x7465646279746573 }
        let body = start ▷ evolve(n div 8, s => sip_absorb(s, word64(data, s.p)))
        let last = (n & 255) << 56 | le_bytes(data, n - n % 8, n % 8)
        let done = sip_absorb(body, last)
        let f = sip_round(sip_round(sip_round(sip_round({ done with v2: done.v2 ^ 0xFF }))))
        f.v0 ^ f.v1 ^ f.v2 ^ f.v3
    }

    // ---- digests ----

    // MD5 (RFC 1321): 16 bytes. Broken for security: a checksum only.
    pub fn md5(data: [u8]) -> [u8] {
        let msg = padded(data, false)
        let (k, s) = (md5_k(), md5_s())
        let h = H4 { off: 0, a: 0x67452301, b: 0xEFCDAB89, c: 0x98BADCFE, d: 0x10325476 } ▷ evolve(≢ msg div 64, h => md5_block(h, msg, k, s))
        let words = [h.a h.b h.c h.d]
        bytes::from(⍳ 16 ¨ (i => words[i div 4] >>> (i % 4 * 8) & 255))
    }

    // SHA-1 (FIPS 180-4): 20 bytes. Broken for security: a checksum only.
    pub fn sha1(data: [u8]) -> [u8] {
        let msg = padded(data, true)
        let h = H5 { off: 0, a: 0x67452301, b: 0xEFCDAB89, c: 0x98BADCFE, d: 0x10325476, e: 0xC3D2E1F0 } ▷ evolve(≢ msg div 64, h => sha1_block(h, msg))
        let words = [h.a h.b h.c h.d h.e]
        bytes::from(⍳ 20 ¨ (i => words[i div 4] >>> (24 - i % 4 * 8) & 255))
    }

    // SHA-256 (FIPS 180-4): 32 bytes.
    pub fn sha256(data: [u8]) -> [u8] {
        let msg = padded(data, true)
        let k = sha256_k()
        let h0 = H8 { off: 0, a: 0x6A09E667, b: 0xBB67AE85, c: 0x3C6EF372, d: 0xA54FF53A, e: 0x510E527F, f: 0x9B05688C, g: 0x1F83D9AB, h: 0x5BE0CD19 }
        let h = h0 ▷ evolve(≢ msg div 64, h => sha256_block(h, msg, k))
        let words = [h.a h.b h.c h.d h.e h.f h.g h.h]
        bytes::from(⍳ 32 ¨ (i => words[i div 4] >>> (24 - i % 4 * 8) & 255))
    }

    // ---- the parts ----

    fn rotl32(x: i64, r: i64) -> i64 { (x << r | x >>> (32 - r)) & 0xFFFFFFFF }
    fn rotr32(x: i64, r: i64) -> i64 { (x >>> r | x << (32 - r)) & 0xFFFFFFFF }
    fn rotl64(x: i64, r: i64) -> i64 { x << r | x >>> (64 - r) }

    // the 32-bit and 64-bit little-endian words at p
    fn word32(d: [u8], p: i64) -> i64 { d[p] | d[p + 1] << 8 | d[p + 2] << 16 | d[p + 3] << 24 }
    fn word64(d: [u8], p: i64) -> i64 { word32(d, p) | word32(d, p + 4) << 32 }

    // the k bytes at p as a little-endian number (k < 8)
    fn le_bytes(d: [u8], p: i64, k: i64) -> i64 { if k == 0 { 0 } else { d[p + k - 1] << (8 * (k - 1)) | le_bytes(d, p, k - 1) }}

    fn crc_entry(c: i64, k: i64, poly: i64) -> i64 {
        if k == 8 { c } else { crc_entry(if c & 1 == 1 { c >>> 1 ^ poly } else { c >>> 1 }, k + 1, poly) }
    }
    fn crc32_table() -> [i64] { ⍳ 256 ¨ (b => crc_entry(b, 0, 0xEDB88320)) }
    fn crc64_table() -> [i64] { ⍳ 256 ¨ (b => crc_entry(b, 0, 0xC96C5795D7870F42)) }
    // a loop's place, its value, and a second value (`evolve` steps: loops
    // in debug builds too, where a function calling itself per byte would
    // run out of stack)
    type Acc = { i: i64, h: i64, b: i64 }

    // Byte by byte, in chunks of 1,024: a function that calls itself within
    // a chunk (a loop in optimised builds, shallow in debug ones), `evolve`
    // from chunk to chunk.
    fn chunk() -> i64 { 1024 }
    fn chunks(d: [u8]) -> i64 { (≢ d + chunk() - 1) div chunk() }
    fn chunk_end(d: [u8], i: i64) -> i64 { (i + chunk()) ⌊ ≢ d }

    fn crc_bytes(d: [u8], t: [i64], i: i64, end: i64, c: i64) -> i64 { if i == end { c } else { crc_bytes(d, t, i + 1, end, t[(c ^ d[i]) & 255] ^ c >>> 8) } }
    fn crc_chunk(a: Acc, d: [u8], t: [i64]) -> Acc { { a with i: chunk_end(d, a.i), h: crc_bytes(d, t, a.i, chunk_end(d, a.i), a.h) } }

    // Adler-32: a (in h) and b reduced every 5,552 bytes (they cannot
    // overflow before)
    fn adler_step(a: Acc, d: [u8]) -> Acc {
        let x = a.h + d[a.i]
        let y = a.b + x
        if a.i % 5552 == 5551 { { a with i: a.i + 1, h: x % 65521, b: y % 65521 } } else { { a with i: a.i + 1, h: x, b: y } }
    }

    fn fnv32_bytes(d: [u8], i: i64, end: i64, h: i64) -> i64 { if i == end { h } else { fnv32_bytes(d, i + 1, end, ((h ^ d[i]) * 0x01000193) & 0xFFFFFFFF) } }
    fn fnv64_bytes(d: [u8], i: i64, end: i64, h: i64) -> i64 { if i == end { h } else { fnv64_bytes(d, i + 1, end, (h ^ d[i]) * 0x100000001B3) } }
    fn fnv32_chunk(a: Acc, d: [u8]) -> Acc { { a with i: chunk_end(d, a.i), h: fnv32_bytes(d, a.i, chunk_end(d, a.i), a.h) } }
    fn fnv64_chunk(a: Acc, d: [u8]) -> Acc { { a with i: chunk_end(d, a.i), h: fnv64_bytes(d, a.i, chunk_end(d, a.i), a.h) } }

    fn murmur_step(a: Acc, d: [u8]) -> Acc {
        let k = rotl32((word32(d, a.i) * 0xCC9E2D51) & 0xFFFFFFFF, 15) * 0x1B873593 & 0xFFFFFFFF
        { a with i: a.i + 4, h: (rotl32(a.h ^ k, 13) * 5 + 0xE6546B64) & 0xFFFFFFFF }
    }
    fn fmix32(h0: i64) -> i64 {
        let h1 = ((h0 ^ h0 >>> 16) * 0x85EBCA6B) & 0xFFFFFFFF
        let h2 = ((h1 ^ h1 >>> 13) * 0xC2B2AE35) & 0xFFFFFFFF
        h2 ^ h2 >>> 16
    }

    // xxHash32: the four lanes after p
    type X32 = { p: i64, v1: i64, v2: i64, v3: i64, v4: i64 }
    fn x32_round(acc: i64, w: i64) -> i64 { (rotl32((acc + w * 2246822519) & 0xFFFFFFFF, 13) * 2654435761) & 0xFFFFFFFF }
    fn x32_stripe(x: X32, d: [u8]) -> X32 {
        let p = x.p
        { x with p: p + 16, v1: x32_round(x.v1, word32(d, p)), v2: x32_round(x.v2, word32(d, p + 4)), v3: x32_round(x.v3, word32(d, p + 8)), v4: x32_round(x.v4, word32(d, p + 12)) }
    }
    // after the stripes: 4-byte words, then bytes
    fn x32_word(a: Acc, d: [u8]) -> Acc { { a with i: a.i + 4, h: (rotl32((a.h + word32(d, a.i) * 3266489917) & 0xFFFFFFFF, 17) * 668265263) & 0xFFFFFFFF } }
    fn x32_byte(a: Acc, d: [u8]) -> Acc { { a with i: a.i + 1, h: (rotl32((a.h + d[a.i] * 374761393) & 0xFFFFFFFF, 11) * 2654435761) & 0xFFFFFFFF } }

    // xxHash64
    fn x64p1() -> i64 { 0x9E3779B185EBCA87 }
    fn x64p2() -> i64 { 0xC2B2AE3D27D4EB4F }
    type X64 = { p: i64, v1: i64, v2: i64, v3: i64, v4: i64 }
    fn x64_round(acc: i64, w: i64) -> i64 { rotl64(acc + w * x64p2(), 31) * x64p1() }
    fn x64_merge(h: i64, v: i64) -> i64 { (h ^ x64_round(0, v)) * x64p1() + 0x85EBCA77C2B2AE63 }
    fn x64_stripe(x: X64, d: [u8]) -> X64 {
        let p = x.p
        { x with p: p + 32, v1: x64_round(x.v1, word64(d, p)), v2: x64_round(x.v2, word64(d, p + 8)), v3: x64_round(x.v3, word64(d, p + 16)), v4: x64_round(x.v4, word64(d, p + 24)) }
    }
    // after the stripes: 8-byte words, then a 4-byte word, then bytes
    fn x64_word(a: Acc, d: [u8]) -> Acc { { a with i: a.i + 8, h: rotl64(a.h ^ x64_round(0, word64(d, a.i)), 27) * x64p1() + 0x85EBCA77C2B2AE63 } }
    fn x64_half(a: Acc, d: [u8]) -> Acc { { a with i: a.i + 4, h: rotl64(a.h ^ word32(d, a.i) * x64p1(), 23) * x64p2() + 0x165667B19E3779F9 } }
    fn x64_byte(a: Acc, d: [u8]) -> Acc { { a with i: a.i + 1, h: rotl64(a.h ^ d[a.i] * 0x27D4EB2F165667C5, 11) * x64p1() } }

    // SipHash: the state, and the next word's place
    type Sip = { p: i64, v0: i64, v1: i64, v2: i64, v3: i64 }
    fn sip_round(s: Sip) -> Sip {
        let a0 = s.v0 + s.v1
        let a1 = rotl64(s.v1, 13) ^ a0
        let b2 = s.v2 + s.v3
        let b3 = rotl64(s.v3, 16) ^ b2
        let c0 = rotl64(a0, 32) + b3
        let c3 = rotl64(b3, 21) ^ c0
        let d2 = b2 + a1
        let d1 = rotl64(a1, 17) ^ d2
        { s with v0: c0, v1: d1, v2: rotl64(d2, 32), v3: c3 }
    }
    fn sip_absorb(s: Sip, m: i64) -> Sip {
        let r = sip_round(sip_round({ s with v3: s.v3 ^ m }))
        { r with p: r.p + 8, v0: r.v0 ^ m }
    }

    // The message for MD5 and SHA: the bytes, 0x80, zeros, and the length
    // in bits in the last 8 bytes (big-endian for SHA, little for MD5).
    fn padded(d: [u8], big: bool) -> [u8] {
        let n = ≢ d
        let total = ((n + 8) div 64 + 1) * 64
        let bits = n * 8
        bytes::from(⍳ total ¨ (i => {
            if i < n { d[i] }
            else if i == n { 128 }
            else if i < total - 8 { 0 }
            else if big { bits >>> ((total - 1 - i) * 8) & 255 }
            else { bits >>> ((i - (total - 8)) * 8) & 255 }
        }))
    }
    fn word32be(d: [u8], p: i64) -> i64 { d[p] << 24 | d[p + 1] << 16 | d[p + 2] << 8 | d[p + 3] }

    // MD5
    type H4 = { off: i64, a: i64, b: i64, c: i64, d: i64 }
    fn md5_k() -> [i64] {
        [0xD76AA478 0xE8C7B756 0x242070DB 0xC1BDCEEE 0xF57C0FAF 0x4787C62A 0xA8304613 0xFD469501
         0x698098D8 0x8B44F7AF 0xFFFF5BB1 0x895CD7BE 0x6B901122 0xFD987193 0xA679438E 0x49B40821
         0xF61E2562 0xC040B340 0x265E5A51 0xE9B6C7AA 0xD62F105D 0x02441453 0xD8A1E681 0xE7D3FBC8
         0x21E1CDE6 0xC33707D6 0xF4D50D87 0x455A14ED 0xA9E3E905 0xFCEFA3F8 0x676F02D9 0x8D2A4C8A
         0xFFFA3942 0x8771F681 0x6D9D6122 0xFDE5380C 0xA4BEEA44 0x4BDECFA9 0xF6BB4B60 0xBEBFBC70
         0x289B7EC6 0xEAA127FA 0xD4EF3085 0x04881D05 0xD9D4D039 0xE6DB99E5 0x1FA27CF8 0xC4AC5665
         0xF4292244 0x432AFF97 0xAB9423A7 0xFC93A039 0x655B59C3 0x8F0CCC92 0xFFEFF47D 0x85845DD1
         0x6FA87E4F 0xFE2CE6E0 0xA3014314 0x4E0811A1 0xF7537E82 0xBD3AF235 0x2AD7D2BB 0xEB86D391]
    }
    fn md5_s() -> [i64] {
        [7 12 17 22 7 12 17 22 7 12 17 22 7 12 17 22 5 9 14 20 5 9 14 20 5 9 14 20 5 9 14 20
         4 11 16 23 4 11 16 23 4 11 16 23 4 11 16 23 6 10 15 21 6 10 15 21 6 10 15 21 6 10 15 21]
    }
    fn md5_steps(m: [u8], off: i64, k: [i64], s: [i64], i: i64, a: i64, b: i64, c: i64, d: i64) -> (i64, i64, i64, i64) {
        if i == 64 { (a, b, c, d) } else {
            let f = if i < 16 { b & c | (b ^ 0xFFFFFFFF) & d } else if i < 32 { d & b | (d ^ 0xFFFFFFFF) & c } else if i < 48 { b ^ c ^ d } else { c ^ (b | (d ^ 0xFFFFFFFF)) }
            let g = if i < 16 { i } else if i < 32 { (5 * i + 1) % 16 } else if i < 48 { (3 * i + 5) % 16 } else { 7 * i % 16 }
            let t = (f + a + k[i] + word32(m, off + 4 * g)) & 0xFFFFFFFF
            md5_steps(m, off, k, s, i + 1, d, (b + rotl32(t, s[i])) & 0xFFFFFFFF, b, c)
        }
    }
    fn md5_block(h: H4, m: [u8], k: [i64], s: [i64]) -> H4 {
        let (a, b, c, d) = md5_steps(m, h.off, k, s, 0, h.a, h.b, h.c, h.d)
        { h with off: h.off + 64, a: (h.a + a) & 0xFFFFFFFF, b: (h.b + b) & 0xFFFFFFFF, c: (h.c + c) & 0xFFFFFFFF, d: (h.d + d) & 0xFFFFFFFF }
    }

    // SHA-1 and SHA-256: the message schedule grows in place
    type W = { w: [i64] }
    fn sha1_more(s: W) -> W {
        let t = ≢ s.w
        let v = rotl32(s.w[t - 3] ^ s.w[t - 8] ^ s.w[t - 14] ^ s.w[t - 16], 1)
        { s with w: push(s.w, v) }
    }
    fn sha256_more(s: W) -> W {
        let t = ≢ s.w
        let (a, b) = (s.w[t - 15], s.w[t - 2])
        let s0 = rotr32(a, 7) ^ rotr32(a, 18) ^ a >>> 3
        let s1 = rotr32(b, 17) ^ rotr32(b, 19) ^ b >>> 10
        let v = (s.w[t - 16] + s0 + s.w[t - 7] + s1) & 0xFFFFFFFF
        { s with w: push(s.w, v) }
    }
    fn first16(m: [u8], off: i64) -> [i64] { ⍳ 16 ¨ (j => word32be(m, off + 4 * j)) }

    type H5 = { off: i64, a: i64, b: i64, c: i64, d: i64, e: i64 }
    fn sha1_rounds(w: [i64], t: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> (i64, i64, i64, i64, i64) {
        if t == 80 { (a, b, c, d, e) } else {
            let f = if t < 20 { b & c | (b ^ 0xFFFFFFFF) & d } else if t < 40 { b ^ c ^ d } else if t < 60 { b & c | b & d | c & d } else { b ^ c ^ d }
            let k = if t < 20 { 0x5A827999 } else if t < 40 { 0x6ED9EBA1 } else if t < 60 { 0x8F1BBCDC } else { 0xCA62C1D6 }
            sha1_rounds(w, t + 1, (rotl32(a, 5) + f + e + k + w[t]) & 0xFFFFFFFF, a, rotl32(b, 30), c, d)
        }
    }
    fn sha1_block(h: H5, m: [u8]) -> H5 {
        let w = (W { w: first16(m, h.off) } ▷ evolve(64, sha1_more)).w
        let (a, b, c, d, e) = sha1_rounds(w, 0, h.a, h.b, h.c, h.d, h.e)
        { h with off: h.off + 64, a: (h.a + a) & 0xFFFFFFFF, b: (h.b + b) & 0xFFFFFFFF, c: (h.c + c) & 0xFFFFFFFF, d: (h.d + d) & 0xFFFFFFFF, e: (h.e + e) & 0xFFFFFFFF }
    }

    type H8 = { off: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64 }
    fn sha256_k() -> [i64] {
        [0x428A2F98 0x71374491 0xB5C0FBCF 0xE9B5DBA5 0x3956C25B 0x59F111F1 0x923F82A4 0xAB1C5ED5
         0xD807AA98 0x12835B01 0x243185BE 0x550C7DC3 0x72BE5D74 0x80DEB1FE 0x9BDC06A7 0xC19BF174
         0xE49B69C1 0xEFBE4786 0x0FC19DC6 0x240CA1CC 0x2DE92C6F 0x4A7484AA 0x5CB0A9DC 0x76F988DA
         0x983E5152 0xA831C66D 0xB00327C8 0xBF597FC7 0xC6E00BF3 0xD5A79147 0x06CA6351 0x14292967
         0x27B70A85 0x2E1B2138 0x4D2C6DFC 0x53380D13 0x650A7354 0x766A0ABB 0x81C2C92E 0x92722C85
         0xA2BFE8A1 0xA81A664B 0xC24B8B70 0xC76C51A3 0xD192E819 0xD6990624 0xF40E3585 0x106AA070
         0x19A4C116 0x1E376C08 0x2748774C 0x34B0BCB5 0x391C0CB3 0x4ED8AA4A 0x5B9CCA4F 0x682E6FF3
         0x748F82EE 0x78A5636F 0x84C87814 0x8CC70208 0x90BEFFFA 0xA4506CEB 0xBEF9A3F7 0xC67178F2]
    }
    // the eight working words after rounds t … 63
    fn sha256_rounds(w: [i64], k: [i64], t: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> H8 {
        if t == 64 { H8 { off: 0, a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h } } else {
            let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
            let ch = e & f ^ (e ^ 0xFFFFFFFF) & g
            let t1 = (h + s1 + ch + k[t] + w[t]) & 0xFFFFFFFF
            let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
            let maj = a & b ^ a & c ^ b & c
            sha256_rounds(w, k, t + 1, (t1 + s0 + maj) & 0xFFFFFFFF, a, b, c, (d + t1) & 0xFFFFFFFF, e, f, g)
        }
    }
    fn sha256_block(st: H8, m: [u8], k: [i64]) -> H8 {
        let w = (W { w: first16(m, st.off) } ▷ evolve(48, sha256_more)).w
        let r = sha256_rounds(w, k, 0, st.a, st.b, st.c, st.d, st.e, st.f, st.g, st.h)
        H8 { off: st.off + 64, a: (st.a + r.a) & 0xFFFFFFFF, b: (st.b + r.b) & 0xFFFFFFFF, c: (st.c + r.c) & 0xFFFFFFFF, d: (st.d + r.d) & 0xFFFFFFFF,
             e: (st.e + r.e) & 0xFFFFFFFF, f: (st.f + r.f) & 0xFFFFFFFF, g: (st.g + r.g) & 0xFFFFFFFF, h: (st.h + r.h) & 0xFFFFFFFF }
    }
}
