module main

// montecarlo: π by throwing 200,000,000 points at the unit square (two
// coordinates per point from splitmix64, 53 bits each) and counting those
// inside the quarter circle. Points are independent, so the count is a
// parallel sum. Prints the count and 4 × count / points to six places.
// The reference is bench/montecarlo/ref.py.

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

fn inside(i: i64) -> i64 {
    let x = (mix(2 * i) >>> 10) / 9007199254740992.0
    let y = (mix(2 * i + 1) >>> 10) / 9007199254740992.0
    if x * x + y * y < 1.0 { 1 } else { 0 }
}

fn main() {
    let n = 200000000
    let count = ⍳ n ¨ inside ▷ +/
    let micro = count * 4000000 div n
    print("{count} {micro div 1000000}.{micro % 1000000}")
}
