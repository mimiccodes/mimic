module main

// `let out = if … { push(s.out, x) } else { concat(s.out, …) }` and then
// `{ s with out: out }`: the record update moves into each branch, so a
// list in a loop's state grows in place (it was copied at every step). The
// results are as before: values in the same order, a record another name
// still holds is copied

type X = { k: i64, out: [i64] }

// a list rebuilt from (length, distance) pairs, as an LZ77 decoder does
fn expand(toks: [i64]) -> [i64] {
    let start = X { k: 0, out: [] }
    let e = start ▷ settle(s => {
        let (k, x) = (toks[s.k], toks[s.k + 1])
        let out = if k == 0 { push(s.out, x) }
            else if x >= k { concat(s.out, s.out ↓ (≢ s.out - x) ↑ k) }
            else { s.out ▷ evolve(k, o => push(o, o[≢ o - x])) }
        { s with k: s.k + 2, out: out }
    }, s => s.k == ≢ toks)
    e.out
}

fn noted(tag: str, v: i64) -> i64 {
    print("{tag} {v}")
    v
}

// the branch first, then the other fields, as written
fn ordered(s: X, c: bool) -> X {
    let out = if c { push(s.out, noted("branch", 1)) } else { push(s.out, noted("branch", 2)) }
    { s with k: noted("field", s.k + 1), out: out }
}

fn main() {
    let toks = [0 1 0 2 0 3 3 3 0 9 4 1 6 4]
    let r = expand(toks)
    print(r)
    // literals, then (length, distance) pairs, a distance at most 4
    let long = expand(⍳ 40000 ¨ (i => if i < 8 { i % 2 * (i + 1) } else if i % 4 < 2 { i % 2 * 9 } else if i % 2 == 0 { 1 + i % 7 } else { 1 + i % 4 }))
    print("{≢ long} {long ▷ +/}")
    let a = X { k: 0, out: [7] }
    let b = ordered(a, true)
    let c = ordered(b, false)
    print("{a.k} {a.out} {b.k} {b.out} {c.k} {c.out}")
}
