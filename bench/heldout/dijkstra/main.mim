module main

// Dijkstra's shortest paths from node 0 on a generated directed graph of
// 8,000 nodes and 40,000 weighted edges held as adjacency lists (a chain
// i -> i+1 keeps it connected). Each step picks the closest unfinished
// node. Prints the sum of the distances.

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn add_edge(adj: [[(i64, i64)]], from: i64, to: i64, w: i64) -> [[(i64, i64)]] {
    let mut out = adj
    out[from] = push(out[from], (to, w))
    out
}

fn chain(i: i64, n: i64, x: i64, adj: [[(i64, i64)]]) -> ([[(i64, i64)]], i64) {
    if i == n - 1 {
        (adj, x)
    } else {
        let y = next(x)
        chain(i + 1, n, y, add_edge(adj, i, i + 1, y % 100 + 1))
    }
}

fn random_edges(count: i64, n: i64, x: i64, adj: [[(i64, i64)]]) -> [[(i64, i64)]] {
    if count == 0 {
        adj
    } else {
        let x1 = next(x)
        let x2 = next(x1)
        let x3 = next(x2)
        random_edges(count - 1, n, x3, add_edge(adj, x1 % n, x2 % n, x3 % 100 + 1))
    }
}

fn relax(dist: [i64], edges: [(i64, i64)], du: i64, k: i64) -> [i64] {
    if k == ≢ edges {
        dist
    } else {
        let (v, w) = edges[k]
        if du + w < dist[v] {
            relax(put(dist, v, du + w), edges, du, k + 1)
        } else {
            relax(dist, edges, du, k + 1)
        }
    }
}

fn dijkstra(adj: [[(i64, i64)]], dist: [i64], done: [bool], inf: i64) -> [i64] {
    let n = ≢ dist
    let open = ⍳ n ¨ (i => if done[i] { inf } else { dist[i] })
    let best = open ▷ ⌊/
    if best == inf {
        dist
    } else {
        let u = (⍳ n ⌿ (open == best))[0]
        dijkstra(adj, relax(dist, adj[u], best, 0), put(done, u, true), inf)
    }
}

fn main() {
    let n = 8000
    let empty: [[(i64, i64)]] = ⍳ n ¨ (i => [])
    let (with_chain, x) = chain(0, n, 42, empty)
    let adj = random_edges(40000 - (n - 1), n, x, with_chain)
    let inf = 1_000_000_000_000
    let start = put(⍳ n ¨ (i => inf), 0, 0)
    let done = ⍳ n ¨ (i => false)
    let dist = dijkstra(adj, start, done, inf)
    print(dist ▷ +/)
}
