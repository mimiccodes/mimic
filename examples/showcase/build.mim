module build

// Build profiles used by `mimic build|run --debug|--release`.
profile debug {
    opt = 0
    debug = true
    leak_check = true
}

profile release {
    opt = 3
    debug = false
    leak_check = false
}

// Extra cross-compilation targets (LLVM triples, e.g. "aarch64-linux"), built with `mimic build --all-targets`.
targets = ["x86_64-linux-musl", "aarch64-linux-musl", "riscv64-linux-musl"]
