module main

// semver: 1,000,000 version strings MAJOR.MINOR.PATCH with an optional
// pre-release (-alpha, -alpha.N, -beta.N, -rc.N), from splitmix64, joined
// into one text, then split into lines, parsed (in parallel) into one
// number each that orders as Semantic Versioning 2.0.0 does, sorted, and
// written back. Prints the first, the median and the last version, and how
// many have a pre-release. The reference is bench/semver/ref.py.

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

fn version(i: i64) -> str {
    let k = mix(i + 40000000) % 20
    let pre = ["" "" "" "" "" "" "-alpha.{k}" "-beta.{k}" "-rc.{k}" "-alpha"][mix(i + 30000000) % 10]
    "{mix(i) % 20}.{mix(i + 10000000) % 30}.{mix(i + 20000000) % 200}{pre}"
}

fn kinds() -> [str] { ["alpha" "beta" "rc"] }

// the order as one number: major, minor, patch, then 0 with a pre-release
// (its kind, and 0 when bare or its number + 1) or 1 without
fn key(v: str) -> i64 {
    let parts = split(v, "-")
    let core = split(parts[0], ".") ¨ to_int
    let base = (core[0] * 100 + core[1]) * 1000 + core[2]
    if ≢ parts == 1 { (base * 2 + 1) * 400 } else {
        let ids = split(parts[1], ".")
        let kind = ⍳ 3 ⌿ (kinds() ¨ (k => k == ids[0])) ▷ +/
        let num = if ≢ ids > 1 { to_int(ids[1]) + 1 } else { 0 }
        base * 2 * 400 + kind * 100 + num
    }
}

// the version a key stands for
fn text_of(k: i64) -> str {
    let base = k div 800
    let core = "{base div 100000}.{base div 1000 % 100}.{base % 1000}"
    if k % 800 >= 400 { core } else {
        let (kind, num) = (k % 400 div 100, k % 100)
        core + "-" + kinds()[kind] + (if num == 0 { "" } else { ".{num - 1}" })
    }
}

fn main() {
    let n = 1000000
    let text = join(⍳ n ¨ version, "\n")
    let keys = sort(lines(text) ¨ key)
    let pre = keys ¨ (k => if k % 800 < 400 { 1 } else { 0 }) ▷ +/
    print("{text_of(keys[0])} {text_of(keys[n div 2])} {text_of(keys[n - 1])} {pre}")
}
