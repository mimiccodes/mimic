module main

// polyeval: 1,000,000 polynomials of degree 31 modulo 1,000,000,007
// (coefficients from splitmix64), each evaluated at its own point by
// Horner's rule: a function that calls itself over the coefficients, the
// polynomials in parallel. Prints the sum of the values modulo p and their
// exclusive or. The reference is bench/polyeval/ref.py.

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

fn p() -> i64 { 1000000007 }

// polynomial k at x, from coefficient j on, with v so far
fn horner(k: i64, x: i64, j: i64, v: i64) -> i64 {
    if j == 32 { v } else { horner(k, x, j + 1, (v * x % p() + mix(32 * k + j) % p()) % p()) }
}

fn main() {
    let vs = ⍳ 1000000 ¨ (k => horner(k, mix(100000000 + k) % p(), 0, 0))
    print("{(vs ▷ +/) % p()} {vs ▷ gather(^)}")
}
