module main

// 2,000 particles (records of position and velocity) move in a 100 x 100
// box with reflecting walls for 10,000 steps; prints the sum of the x and
// y positions.

type Particle = { x: f64, y: f64, vx: f64, vy: f64 }

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn make(n: i64, seed: i64, ps: [Particle]) -> [Particle] {
    if n == 0 {
        ps
    } else {
        let s1 = next(seed)
        let s2 = next(s1)
        let s3 = next(s2)
        let s4 = next(s3)
        let p = Particle {
            x: (s1 % 1600) / 16,
            y: (s2 % 1600) / 16,
            vx: (s3 % 2001 - 1000) / 256,
            vy: (s4 % 2001 - 1000) / 256,
        }
        make(n - 1, s4, push(ps, p))
    }
}

// a coordinate that left the box comes back in, moving the other way
fn bounce(p: f64, v: f64) -> (f64, f64) {
    if p < 0.0 {
        (-p, -v)
    } else if p > 100.0 {
        (200.0 - p, -v)
    } else {
        (p, v)
    }
}

fn move(p: Particle) -> Particle {
    let dt = 0.125
    let (x, vx) = bounce(p.x + p.vx * dt, p.vx)
    let (y, vy) = bounce(p.y + p.vy * dt, p.vy)
    Particle { x: x, y: y, vx: vx, vy: vy }
}

fn main() {
    let start = make(2000, 42, [])
    let end = start ▷ evolve(10000, ps => ps ¨ move)
    let sx = end ¨ (p => p.x) ▷ +/
    let sy = end ¨ (p => p.y) ▷ +/
    print("{sx:.6}")
    print("{sy:.6}")
}
