module main

// a loop whose state is a record kept in registers, holding a short list
// read and changed at indexes known only when running (a machine's tape):
// compiled whole, the state never built on the heap; and a loop's start
// with an empty list taking its type from the step

type M = { pc: i64, ptr: i64, tape: [i64] }

fn step(m: M, prog: [i64]) -> M {
    let c = prog[m.pc]
    if c == 1 { { m with pc: m.pc + 1, tape: put(m.tape, m.ptr, m.tape[m.ptr] + 3) } }
    else if c == 2 { { m with pc: m.pc + 1, ptr: m.ptr + 1 } }
    else if c == 3 { { m with pc: m.pc + 1, tape: put(m.tape, m.ptr, m.tape[m.ptr] * 2) } }
    else { { m with pc: m.pc + 1, ptr: m.ptr - 1 } }
}

fn run(prog: [i64]) -> M {
    M { pc: 0, ptr: 0, tape: ⍳ 4 ¨ (_ => 0) } ▷ settle(s => step(s, prog), s => s.pc == ≢ prog)
}

// floats too
fn halves(n: i64) -> [f64] {
    let r = [1.0, 2.0, 4.0] ▷ evolve(n, xs => put(xs, n % 3, xs[n % 3] / 2.0))
    r
}

// (i, the marks so far): `[]` takes the step's list of numbers
fn evens(xs: [i64]) -> [i64] {
    let (_, out) = (0, []) ▷ settle(s => {
        let (i, acc) = s
        if xs[i] % 2 == 0 { (i + 1, push(acc, xs[i])) } else { (i + 1, acc) }
    }, s => s.0 == ≢ xs)
    out
}

fn main() {
    let m = run([1, 1, 2, 1, 3, 2, 1, 4, 3])
    print("{m.pc} {m.ptr} {m.tape}")
    print(halves(4))
    print(evens([3, 4, 8, 1, 6]))
    print(evens([]))
}
