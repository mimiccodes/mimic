
// Interfaces: a screen is a value. `view(state)` describes it, `update(state,
// message)` makes the next state, and `ui::run(init, view, update)` shows it
// in the browser. See docs/ui.md. (Appended to the prelude.)
pub module ui {
    // A piece of the screen. `M` is the program's message type.
    pub type Node[M] = Elem(str, [Attr[M]], [Node[M]]) | Txt(str)

    // A setting of an element: an HTML attribute, an event that becomes a
    // message, or an event whose text (what was typed) becomes a message.
    pub type Attr[M] = Prop(str, str) | On(str, M) | OnText(str, fn(str) -> M)

    // An event from the browser: the element's path, the event and its value.
    pub type Event = { p: str, e: str, v: str }

    // A change for the browser to make (runtime/mimic_ui.c applies it).
    pub type Patch = { op: str, p: str, html: str, attrs: [str], at: i64 }

    // What `update` returns in `ui::run_live`: the next state, and jobs to run
    // on their own (fetching, saving, …); each job's result comes back as a
    // message. Make one with `ui::stay(state)` or `ui::then(state, job)`.
    pub type Step[S, M] = { state: S, jobs: [fn() -> M] }

    // Messages that arrive by themselves: every `interval` (a duration), or
    // whenever a value comes through a channel.
    pub type Sub[M] = Every(i64, M) | Listen(super::chan::Receiver[M])

    // What a tab's session waits for.
    type Incoming[M] = FromBrowser(str) | FromWork(M) | Gone

    extern "mimic" concurrent {
        fn serve_app(port: i64, page: fn(super::http::Request) -> super::http::Response, session: fn(super::ws::Socket), count: i64) -> Result[i64, str]
    }

    extern "mimic" {
        fn client_script() -> str
    }

    extern "mimic" concurrent {
        // run f() as a task of its own that nobody waits for
        fn detach(f: fn())
        // in a web page (mimic build --web): keep the app, return to the page
        fn hand_to_browser(app: fn(str) -> str)
    }

    extern "mimic" {
        fn in_browser() -> bool
        fn host() -> str
        fn esc() -> str
    }

    // the terminal (runtime/mimic_ui.c). Only a tab's own loop draws, and the
    // end of the loop is an argument of the clean-up (see in_terminal), so
    // these may count as overlapping: serving a page is not held back by them.
    extern "mimic" concurrent {
        fn term_start() -> Result[bool, str]
        fn term_stop()
        fn term_draw(text: str)
        fn term_size() -> (i64, i64)
        fn term_key() -> str
        // a native window (runtime/mimic_window.c)
        fn window_run(html: str, title: str, post: fn(str) -> bool) -> Result[i64, str]
        fn window_apply(patches: str)
    }

    // How a page starts: the first screen, and the subscriptions' intervals
    // in milliseconds (the page runs the timers).
    type BrowserStart = { html: str, every: [i64], css: str, title: str }

    // The next state and a job whose result (a message) comes back later.
    pub extern "mimic" {
        fn then[S, M](state: S, job: fn() -> M) -> Step[S, M]
        fn also[S, M](step: Step[S, M], job: fn() -> M) -> Step[S, M]
    }

    // The next state, with nothing else to do.
    pub fn stay[S, M](state: S) -> Step[S, M] { Step { state: state, jobs: [] } }

    // A message every `interval`.
    pub fn every[M](interval: i64, message: M) -> Sub[M] { Every(interval, message) }

    // Each value that comes through `receiver`, as a message.
    pub fn listen[M](receiver: super::chan::Receiver[M]) -> Sub[M] { Listen(receiver) }

    // ---- layout -------------------------------------------------------------

    // Children one below the other.
    pub fn column[M](children: [Node[M]], gap: i64 = 0, padding: i64 = 0, align: str = "", background: str = "", grow: bool = false) -> Node[M] {
        box_of(children, "column", gap, padding, align, background, grow)
    }

    // Children side by side, centred vertically.
    pub fn row[M](children: [Node[M]], gap: i64 = 8, padding: i64 = 0, align: str = "center", background: str = "", grow: bool = false) -> Node[M] {
        box_of(children, "row", gap, padding, align, background, grow)
    }

    // Children in a grid of `columns` equal columns.
    pub fn grid[M](children: [Node[M]], columns: i64 = 2, gap: i64 = 8) -> Node[M] {
        Elem("div", [Prop("style", css([("display", "grid"), ("grid-template-columns", "repeat({columns}, minmax(0, 1fr))"), ("gap", px(gap))]))], children)
    }

    // Empty space that pushes its neighbours apart.
    pub fn spacer[M]() -> Node[M] { Elem("div", [Prop("style", "flex:1")], []) }

    // `node`, known by `key` among its siblings: when a list changes, rows are
    // matched by key, so inserting or removing one row touches only that row.
    pub fn keyed[M](key: str, node: Node[M]) -> Node[M] {
        match node {
            Elem(tag, attrs, kids) => Elem(tag, push(attrs, Prop("data-key", key)), kids),
            Txt(t) => Elem("span", [Prop("data-key", key)], [Txt(t)]),
        }
    }

    // A thin line.
    pub fn divider[M]() -> Node[M] { Elem("hr", [], []) }

    fn box_of[M](children: [Node[M]], direction: str, gap: i64, padding: i64, align: str, background: str, grow: bool) -> Node[M] {
        let style = css([
            ("display", "flex"),
            ("flex-direction", direction),
            ("gap", px(gap)),
            ("padding", px(padding)),
            ("align-items", align),
            ("background", background),
            ("flex", if grow { "1" } else { "" }),
        ])
        Elem("div", [Prop("style", style)], children)
    }

    // ---- content ------------------------------------------------------------

    // Text. `size` in pixels (0: the default), `weight` such as "bold".
    pub fn text[M](content: str, size: i64 = 0, weight: str = "", color: str = "", strike: bool = false) -> Node[M] {
        let style = css([
            ("font-size", px(size)),
            ("font-weight", weight),
            ("color", color),
            ("text-decoration", if strike { "line-through" } else { "" }),
        ])
        Elem("span", props([("style", style)]), [Txt(content)])
    }

    // A link to another page.
    pub fn link[M](label: str, url: str) -> Node[M] { Elem("a", [Prop("href", url)], [Txt(label)]) }

    // An image; width and height in pixels (0: its natural size).
    pub fn image[M](url: str, width: i64 = 0, height: i64 = 0, alt: str = "") -> Node[M] {
        Elem("img", props([("src", url), ("alt", alt), ("style", css([("width", px(width)), ("height", px(height))]))]), [])
    }

    // ---- input --------------------------------------------------------------

    // A button: clicking it sends `on_click`.
    pub fn button[M](label: str, on_click: M) -> Node[M] { Elem("button", [Prop("type", "button"), On("click", on_click)], [Txt(label)]) }

    // A text box showing `value`; every change sends `on_input(text)`.
    pub fn input[M](value: str, on_input: fn(str) -> M, placeholder: str = "") -> Node[M] {
        Elem("input", concat(props([("type", "text"), ("value", value), ("placeholder", placeholder)]), [OnText("input", on_input)]), [])
    }

    // A check box; clicking it sends `on_change(checked)`.
    pub fn checkbox[M](checked: bool, on_change: fn(bool) -> M) -> Node[M] {
        let base = [Prop("type", "checkbox"), OnText("change", v => on_change(v == "true"))]
        Elem("input", if checked { push(base, Prop("checked", "")) } else { base }, [])
    }

    // A row of inputs that sends `on_submit` when Enter is pressed in one of
    // them, or when its `submit` button is clicked.
    pub fn form[M](children: [Node[M]], on_submit: M, gap: i64 = 8) -> Node[M] {
        Elem("form", [Prop("style", css([("display", "flex"), ("gap", px(gap)), ("align-items", "center")])), On("submit", on_submit)], children)
    }

    // The button that submits its form.
    pub fn submit[M](label: str) -> Node[M] { Elem("button", [Prop("type", "submit")], [Txt(label)]) }

    // ---- running --------------------------------------------------------------

    // Serve the interface at http://localhost:{port}/ until the program is
    // stopped, each browser tab with its own state. `connections` > 0 stops
    // after that many connections (page loads and tabs), for tests.
    //
    // `show` chooses where: "browser" (served), "window" (a native window),
    // "terminal"; by default the MIMIC_UI environment variable decides, as
    // `mimic run --window` / `--terminal` set it, else the browser.
    pub fn run[S, M](init: S, view: fn(S) -> Node[M], update: fn(S, M) -> S, port: i64 = 8080, title: str = "Mimic", connections: i64 = 0, show: str = "") -> Result[i64, str] {
        run_live(init, view, (s, m) => stay(update(s, m)), port: port, title: title, connections: connections, show: show)
    }

    // The same, with jobs (`update` returns a `ui::Step`) and subscriptions.
    pub fn run_live[S, M](init: S, view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], subscriptions: [Sub[M]] = [], port: i64 = 8080, title: str = "Mimic", connections: i64 = 0, show: str = "") -> Result[i64, str] {
        let where = if show != "" { show } else { host() }
        if in_browser() {
            in_page(init, view, update, subscriptions, title)
        } else if where == "terminal" {
            in_terminal(init, view, update, subscriptions, title)
        } else if where == "window" {
            in_window(init, view, update, subscriptions, title)
        } else {
            serve_live(init, view, update, subscriptions, port, title, connections)
        }
    }

    fn serve_live[S, M](init: S, view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], subscriptions: [Sub[M]], port: i64, title: str, connections: i64) -> Result[i64, str] {
        serve_app(port, req => page_for(req, view(init), title), sock => session(sock, init, view, update, subscriptions), connections)
    }

    // ---- in a web page (WebAssembly) ------------------------------------------
    // The page calls the app with "" (start), "@every N" (a timer) or an event,
    // and gets JSON back. The state lives in a channel between calls. Jobs run
    // right after the message that started them.

    fn in_page[S, M](init: S, view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], subs: [Sub[M]], title: str) -> Result[i64, str] {
        let (tx, rx) = super::chan::new[(S, Node[M])]()
        super::chan::send(tx, (init, view(init)))
        hand_to_browser(input => page_step(input, tx, rx, view, update, subs, title))
        Ok(0)
    }

    fn page_step[S, M](input: str, tx: super::chan::Sender[(S, Node[M])], rx: super::chan::Receiver[(S, Node[M])], view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], subs: [Sub[M]], title: str) -> str {
        let now = super::chan::receive(rx) else { return "[]" }
        let (state, tree) = now
        if input == "" {
            super::chan::send(tx, now)
            super::json::encode(BrowserStart { html: html(tree), every: subs ¨ (sb => match sb { Every(d, _) => d div 1000000, _ => 0 }), css: theme(), title: title })
        } else {
            let m = if starts_with(input, "@every ") { sub_message(subs, parse_int(input ↓ 7)) } else { message(tree, input) }
            match m {
                Some(msg) => {
                    let (s2, t2, patches) = apply_in_page(state, tree, view, update, msg)
                    super::chan::send(tx, (s2, t2))
                    super::json::encode(patches)
                }
                None => {
                    super::chan::send(tx, now)
                    "[]"
                }
            }
        }
    }

    fn sub_message[M](subs: [Sub[M]], i: Option[i64]) -> Option[M] {
        match i {
            Some(k) if k >= 0 and k < ≢ subs => match subs[k] {
                Every(_, m) => Some(m),
                _ => None,
            },
            _ => None,
        }
    }

    fn apply_in_page[S, M](state: S, tree: Node[M], view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], m: M) -> (S, Node[M], [Patch]) {
        let step = update(state, m)
        let next = view(step.state)
        jobs_in_page(step.state, next, diff(tree, next, "0"), step.jobs, view, update)
    }

    fn jobs_in_page[S, M](state: S, tree: Node[M], patches: [Patch], jobs: [fn() -> M], view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M]) -> (S, Node[M], [Patch]) {
        if ≢ jobs == 0 {
            (state, tree, patches)
        } else {
            let job = jobs[0]
            let (s2, t2, more) = apply_in_page(state, tree, view, update, job())
            jobs_in_page(s2, t2, concat(patches, more), jobs ↓ 1, view, update)
        }
    }

    // ---- in a native window ------------------------------------------------------
    // The tab's loop runs as a task and sends patches to the window, which the
    // main thread runs (AppKit); clicks and typing come back as events.

    fn in_window[S, M](init: S, view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], subs: [Sub[M]], title: str) -> Result[i64, str] {
        let (tx, rx) = super::chan::new[Incoming[M]]()
        let first = view(init)
        detach(() => window_loop(rx, tx, init, first, view, update))
        subs ¨ (sb => start(sb, tx))
        // (the window is an argument: it is closed before the channel is)
        window_end(window_run(html(first), title, k => super::chan::send(tx, if k == "@close" { Gone } else { FromBrowser(k) })), tx)
    }

    fn window_end[M](r: Result[i64, str], tx: super::chan::Sender[Incoming[M]]) -> Result[i64, str] {
        super::chan::close(tx)
        r
    }

    fn window_loop[S, M](rx: super::chan::Receiver[Incoming[M]], tx: super::chan::Sender[Incoming[M]], state: S, tree: Node[M], view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M]) {
        match super::chan::receive(rx) {
            Some(FromBrowser(t)) => {
                match message(tree, t) {
                    Some(m) => window_react(rx, tx, state, tree, view, update, m),
                    None => window_loop(rx, tx, state, tree, view, update),
                }
            }
            Some(FromWork(m)) => window_react(rx, tx, state, tree, view, update, m),
            _ => {}
        }
    }

    fn window_react[S, M](rx: super::chan::Receiver[Incoming[M]], tx: super::chan::Sender[Incoming[M]], state: S, tree: Node[M], view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], m: M) {
        let step = update(state, m)
        let next = view(step.state)
        window_apply(super::json::encode(diff(tree, next, "0")))
        step.jobs ¨ (job => detach(() => run_job(job, tx)))
        window_loop(rx, tx, step.state, next, view, update)
    }

    // ---- in a terminal --------------------------------------------------------
    // The screen is drawn from the tree each time it changes. Tab and the
    // arrow keys move the focus, Enter or Space presses, typing edits the
    // focused text box, Enter in a text box submits its form, Esc quits.

    fn in_terminal[S, M](init: S, view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], subs: [Sub[M]], title: str) -> Result[i64, str] {
        match term_start() {
            Err(e) => Err(e),
            Ok(_) => {
                let (tx, rx) = super::chan::new[Incoming[M]]()
                detach(() => read_keys(tx))
                subs ¨ (sb => start(sb, tx))
                // (the loop is an argument: it ends before the terminal is restored)
                Ok(term_end(term_loop(rx, tx, init, view(init), 0, view, update, title, 0), tx))
            }
        }
    }

    fn term_end[M](handled: i64, tx: super::chan::Sender[Incoming[M]]) -> i64 {
        term_stop()
        super::chan::close(tx)
        handled
    }

    fn read_keys[M](tx: super::chan::Sender[Incoming[M]]) {
        let k = term_key()
        if super::chan::send(tx, FromBrowser(k)) {
            if k != "esc" and k != "ctrl-c" and k != "eof" { read_keys(tx) }
        }
    }

    // -> how many messages were handled
    fn term_loop[S, M](rx: super::chan::Receiver[Incoming[M]], tx: super::chan::Sender[Incoming[M]], state: S, tree: Node[M], focus: i64, view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], title: str, handled: i64) -> i64 {
        let fs = focusables(tree, "0")
        let f = if ≢ fs == 0 { 0 } else { focus % ≢ fs }
        let here = if ≢ fs == 0 { "" } else { fs[f] }
        term_draw(screen(tree, here, title))
        match super::chan::receive(rx) {
            Some(FromBrowser(k)) => {
                if k == "esc" or k == "ctrl-c" or k == "eof" {
                    handled
                } else if k == "tab" or k == "down" or k == "right" {
                    term_loop(rx, tx, state, tree, f + 1, view, update, title, handled)
                } else if k == "backtab" or k == "up" or k == "left" {
                    term_loop(rx, tx, state, tree, f - 1, view, update, title, handled)
                } else {
                    match key_message(tree, here, k) {
                        Some(m) => term_apply(rx, tx, state, tree, f, view, update, title, handled, m),
                        None => term_loop(rx, tx, state, tree, f, view, update, title, handled),
                    }
                }
            }
            Some(FromWork(m)) => term_apply(rx, tx, state, tree, f, view, update, title, handled, m),
            _ => handled,
        }
    }

    fn term_apply[S, M](rx: super::chan::Receiver[Incoming[M]], tx: super::chan::Sender[Incoming[M]], state: S, tree: Node[M], f: i64, view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], title: str, handled: i64, m: M) -> i64 {
        let step = update(state, m)
        step.jobs ¨ (job => detach(() => run_job(job, tx)))
        term_loop(rx, tx, step.state, view(step.state), f, view, update, title, handled + 1)
    }

    // the elements a key can reach, in reading order
    pub fn focusables[M](n: Node[M], path: str) -> [str] {
        match n {
            Txt(_) => [],
            Elem(_, attrs, kids) => {
                let submits = match prop(attrs, "type") { Some(t) => t == "submit", None => false }
                let mine = if submits or has_event(attrs, "click") or has_event(attrs, "input") or has_event(attrs, "change") { [path] } else { [] }
                concat(mine, flatten(⍳ ≢ kids ¨ (i => focusables(kids[i], "{path}.{i}"))))
            }
        }
    }

    fn has_event[M](attrs: [Attr[M]], e: str) -> bool {
        ((attrs ¨ (a => match a { On(x, _) => if x == e { 1 } else { 0 }, OnText(x, _) => if x == e { 1 } else { 0 }, _ => 0 })) ▷ +/) > 0
    }

    fn prop[M](attrs: [Attr[M]], name: str) -> Option[str] {
        if ≢ attrs == 0 {
            None
        } else {
            match attrs[0] {
                Prop(k, v) if k == name => Some(v),
                _ => prop(attrs ↓ 1, name),
            }
        }
    }

    fn prop_or[M](attrs: [Attr[M]], name: str) -> str {
        match prop(attrs, name) {
            Some(v) => v,
            None => "",
        }
    }

    // the message a key stands for on the focused element
    pub fn key_message[M](tree: Node[M], here: str, k: str) -> Option[M] {
        let at = (split(here, ".") ↓ 1) ¨ (x => match parse_int(x) { Some(i) => i, None => -1 })
        match node_at(tree, at) {
            Some(Elem(tag, attrs, _)) => {
                let kind = if tag == "input" { prop_or(attrs, "type") } else { tag }
                let press = k == "enter" or k == " "
                if kind == "checkbox" {
                    if press { handler(attrs, Event { p: here, e: "change", v: if has_attr(attrs, "checked") { "false" } else { "true" } }) } else { None }
                } else if kind == "text" {
                    let v = prop_or(attrs, "value")
                    if k == "enter" {
                        submit_above(tree, here)
                    } else if k == "backspace" {
                        handler(attrs, Event { p: here, e: "input", v: join(chars(v) ↓ ¯1, "") })
                    } else if ≢ chars(k) == 1 {
                        handler(attrs, Event { p: here, e: "input", v: v + k })
                    } else {
                        None
                    }
                } else if press and prop_or(attrs, "type") == "submit" {
                    submit_above(tree, here)
                } else if press {
                    handler(attrs, Event { p: here, e: "click", v: "" })
                } else {
                    None
                }
            }
            _ => None,
        }
    }

    fn has_attr[M](attrs: [Attr[M]], name: str) -> bool {
        match prop(attrs, name) {
            Some(_) => true,
            None => false,
        }
    }

    // Enter in a text box: the nearest form around it
    fn submit_above[M](tree: Node[M], path: str) -> Option[M] {
        let parts = split(path, ".")
        if ≢ parts <= 1 {
            None
        } else {
            let up = join(parts ↓ ¯1, ".")
            let at = (split(up, ".") ↓ 1) ¨ (x => match parse_int(x) { Some(i) => i, None => -1 })
            match node_at(tree, at) {
                Some(Elem(_, attrs, _)) if has_event(attrs, "submit") => handler(attrs, Event { p: up, e: "submit", v: "" }),
                _ => submit_above(tree, up),
            }
        }
    }

    // ---- drawing in a terminal: blocks of lines with known widths ------------

    type Block = { lines: [str], widths: [i64] }

    // A screen as terminal text (with styles), `focus` being the path of the
    // focused element ("" for none).
    pub fn terminal_text[M](tree: Node[M], focus: str, title: str) -> str { screen(tree, focus, title) }

    fn screen[M](tree: Node[M], focus: str, title: str) -> str {
        let b = draw(tree, "0", focus)
        let head = style("1", title)
        let help = style("2", "Tab: next   Enter or Space: press   Esc: quit")
        join(concat(concat([head ""], b.lines), ["" help]), "\n")
    }

    // terminal text without its styles (for tests and logs)
    pub fn plain(t: str) -> str {
        let parts = split(t, esc())
        if ≢ parts == 0 { t } else { parts[0] + join((parts ↓ 1) ¨ (p => match find(p, "m") { Some(i) => p ↓ (i + 1), None => p }), "") }
    }

    fn style(codes: str, t: str) -> str { if codes == "" { t } else { esc() + "[" + codes + "m" + t + esc() + "[0m" } }

    fn text_block(t: str, codes: str) -> Block { Block { lines: [style(codes, t)], widths: [≢ chars(t)] } }

    fn draw[M](n: Node[M], path: str, focus: str) -> Block {
        match n {
            Txt(t) => text_block(t, ""),
            Elem(tag, attrs, kids) => {
                let css = prop_or(attrs, "style")
                let focused = path == focus
                let mark = if focused { "7" } else { "" }
                if tag == "button" {
                    text_block("[ " + inner_text(kids) + " ]", mark)
                } else if tag == "input" and prop_or(attrs, "type") == "checkbox" {
                    text_block(if has_attr(attrs, "checked") { "[x]" } else { "[ ]" }, mark)
                } else if tag == "input" {
                    let v = prop_or(attrs, "value")
                    let shown = if v == "" and not focused { prop_or(attrs, "placeholder") } else { v }
                    let cursor = if focused { "_" } else { "" }
                    let w = ≢ chars(shown) + ≢ chars(cursor)
                    let pad = repeat(" ", if w < 16 { 16 - w } else { 0 })
                    Block { lines: ["[" + style(if focused { "4" } else if v == "" { "2" } else { "" }, shown + cursor + pad) + "]"], widths: [w + ≢ chars(pad) + 2] }
                } else if tag == "span" {
                    text_block(inner_text(kids), text_codes(css))
                } else if tag == "a" {
                    text_block(inner_text(kids), "4")
                } else if tag == "img" {
                    text_block("[image " + prop_or(attrs, "alt") + "]", "2")
                } else if tag == "hr" {
                    text_block(repeat("─", 32), "2")
                } else if contains(css, "flex:1") and ≢ kids == 0 {
                    text_block("  ", "")
                } else if contains(css, "display:grid") {
                    grid_block(⍳ ≢ kids ¨ (i => draw(kids[i], "{path}.{i}", focus)), columns_of(css))
                } else if tag == "form" or contains(css, "flex-direction:row") {
                    side_by_side(⍳ ≢ kids ¨ (i => draw(kids[i], "{path}.{i}", focus)), 1 + px_of(css, "gap:") div 12)
                } else {
                    let pad = px_of(css, "padding:")
                    indent(stack(⍳ ≢ kids ¨ (i => draw(kids[i], "{path}.{i}", focus)), px_of(css, "gap:") div 12), pad div 8)
                }
            }
        }
    }

    // the text of an element's children (texts, nested spans)
    fn inner_text[M](kids: [Node[M]]) -> str {
        join(kids ¨ (k => match k { Txt(t) => t, Elem(_, _, ks) => inner_text(ks) }), "")
    }

    fn text_codes(css: str) -> str {
        let parts = [
            if contains(css, "font-weight:bold") or contains(css, "font-weight:6") or contains(css, "font-weight:7") { "1" } else { "" },
            if contains(css, "line-through") { "9" } else { "" },
            if contains(css, "color:") { "2" } else { "" },
        ]
        join(parts ⌿ (parts ¨ (c => c != "")), ";")
    }

    // the number of pixels after `key` in a style ("gap:12px" -> 12), or 0
    fn px_of(css: str, key: str) -> i64 {
        match find(css, key) {
            Some(i) => {
                let rest = css ↓ (i + ≢ key)
                match find(rest, "px") {
                    Some(j) => match parse_int(rest ↑ j) { Some(n) => n, None => 0 },
                    None => 0,
                }
            }
            None => 0,
        }
    }

    fn columns_of(css: str) -> i64 {
        match find(css, "repeat(") {
            Some(i) => {
                let rest = css ↓ (i + 7)
                match find(rest, ",") {
                    Some(j) => match parse_int(rest ↑ j) { Some(n) => if n > 0 { n } else { 1 }, None => 1 },
                    None => 1,
                }
            }
            None => 1,
        }
    }

    fn block_width(b: Block) -> i64 { if ≢ b.widths == 0 { 0 } else { b.widths ▷ ⌈/ } }

    fn pad_line(line: str, w: i64, to: i64) -> str { if w >= to { line } else { line + repeat(" ", to - w) } }

    // blocks one below the other, `gap` empty lines between
    fn stack(bs: [Block], gap: i64) -> Block {
        if ≢ bs == 0 {
            Block { lines: [], widths: [] }
        } else {
            let spaced = ⍳ ≢ bs ¨ (i => if i == 0 or gap == 0 { bs[i] } else { Block { lines: concat(repeat_lines(gap), bs[i].lines), widths: concat(⍳ gap ¨ (_ => 0), bs[i].widths) } })
            Block { lines: flatten(spaced ¨ (b => b.lines)), widths: flatten(spaced ¨ (b => b.widths)) }
        }
    }

    fn repeat_lines(n: i64) -> [str] { ⍳ n ¨ (_ => "") }

    // blocks side by side, `gap` spaces between, aligned at the top
    fn side_by_side(bs: [Block], gap: i64) -> Block {
        if ≢ bs == 0 {
            Block { lines: [], widths: [] }
        } else {
            let height = (bs ¨ (b => ≢ b.lines)) ▷ ⌈/
            let ws = bs ¨ block_width
            let total = (ws ▷ +/) + gap * (≢ bs - 1)
            let rows = ⍳ height ¨ (r => join(⍳ ≢ bs ¨ (i => cell(bs[i], r, ws[i])), repeat(" ", gap)))
            Block { lines: rows, widths: ⍳ height ¨ (_ => total) }
        }
    }

    fn cell(b: Block, r: i64, w: i64) -> str { if r < ≢ b.lines { pad_line(b.lines[r], b.widths[r], w) } else { repeat(" ", w) } }

    fn grid_block(bs: [Block], columns: i64) -> Block {
        let rows = (≢ bs + columns - 1) div columns
        stack(⍳ rows ¨ (r => side_by_side((bs ↓ (r * columns)) ↑ columns, 2)), 0)
    }

    fn indent(b: Block, n: i64) -> Block {
        if n == 0 { b } else { Block { lines: b.lines ¨ (l => repeat(" ", n) + l), widths: b.widths ¨ (w => w + n) } }
    }

    fn page_for[M](req: super::http::Request, tree: Node[M], title: str) -> super::http::Response {
        if req.path == "/" { page(tree, title) } else { super::http::not_found() }
    }

    // The whole page for a screen: HTML, the theme and the browser script.
    pub fn page[M](tree: Node[M], title: str) -> super::http::Response {
        let head = "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{escape(title)}</title><style>{theme()}</style></head>"
        let body = "<body>{html(tree)}<script>{client_script()}</script></body></html>"
        super::http::Response { status: 200, headers: ["content-type": "text/html; charset=utf-8"], body: head + body }
    }

    // One browser tab. Everything it reacts to arrives through one channel:
    // the browser's events (read by a task of their own), the results of
    // jobs and the subscriptions' messages.
    fn session[S, M](sock: super::ws::Socket, init: S, view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], subs: [Sub[M]]) {
        let (tx, rx) = super::chan::new[Incoming[M]]()
        detach(() => forward(sock, tx))
        subs ¨ (sb => start(sb, tx))
        serve_tab(sock, rx, tx, init, view(init), view, update)
        super::chan::close(tx)                     // ends the subscriptions
    }

    fn forward[M](sock: super::ws::Socket, tx: super::chan::Sender[Incoming[M]]) {
        match super::ws::receive(sock) {
            Ok(super::ws::Text(t)) => {
                super::chan::send(tx, FromBrowser(t))
                forward(sock, tx)
            }
            _ => { super::chan::send(tx, Gone) }
        }
    }

    fn start[M](sb: Sub[M], tx: super::chan::Sender[Incoming[M]]) {
        match sb {
            Every(interval, m) => detach(() => tick(interval, m, tx)),
            Listen(r) => detach(() => relay(r, tx)),
        }
    }

    // (a send fails once the tab is gone: then the subscription stops)
    fn tick[M](interval: i64, m: M, tx: super::chan::Sender[Incoming[M]]) {
        super::time::sleep(interval)
        if super::chan::send(tx, FromWork(m)) { tick(interval, m, tx) }
    }

    fn relay[M](r: super::chan::Receiver[M], tx: super::chan::Sender[Incoming[M]]) {
        match super::chan::receive(r) {
            Some(m) => { if super::chan::send(tx, FromWork(m)) { relay(r, tx) } }
            None => {}
        }
    }

    fn run_job[M](job: fn() -> M, tx: super::chan::Sender[Incoming[M]]) { super::chan::send(tx, FromWork(job())) }

    fn serve_tab[S, M](sock: super::ws::Socket, rx: super::chan::Receiver[Incoming[M]], tx: super::chan::Sender[Incoming[M]], state: S, tree: Node[M], view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M]) {
        match super::chan::receive(rx) {
            Some(FromBrowser(t)) => {
                match message(tree, t) {
                    Some(m) => react(sock, rx, tx, state, tree, view, update, m),
                    None => serve_tab(sock, rx, tx, state, tree, view, update),
                }
            }
            Some(FromWork(m)) => react(sock, rx, tx, state, tree, view, update, m),
            _ => {}
        }
    }

    // one message: the next state, what changed on the screen, and the jobs
    fn react[S, M](sock: super::ws::Socket, rx: super::chan::Receiver[Incoming[M]], tx: super::chan::Sender[Incoming[M]], state: S, tree: Node[M], view: fn(S) -> Node[M], update: fn(S, M) -> Step[S, M], m: M) {
        let step = update(state, m)
        let next_tree = view(step.state)
        super::ws::send(sock, super::json::encode(diff(tree, next_tree, "0")))
        step.jobs ¨ (job => detach(() => run_job(job, tx)))
        serve_tab(sock, rx, tx, step.state, next_tree, view, update)
    }

    // ---- HTML -------------------------------------------------------------------

    // A screen as HTML (its elements carry their paths, for the browser script).
    pub fn html[M](n: Node[M]) -> str { render(n, "0") }

    fn render[M](n: Node[M], path: str) -> str {
        match n {
            Txt(t) => escape(t),
            Elem(tag, attrs, kids) => {
                let open = "<{tag} data-p=\"{path}\"{attrs_html(attrs)}>"
                if tag == "input" or tag == "img" or tag == "hr" { open } else { open + kids_html(kids, path) + "</{tag}>" }
            }
        }
    }

    fn kids_html[M](kids: [Node[M]], path: str) -> str { join(⍳ ≢ kids ¨ (i => render(kids[i], "{path}.{i}")), "") }

    fn attrs_html[M](attrs: [Attr[M]]) -> str {
        let flat = flat_attrs(attrs)
        join(⍳ (≢ flat div 2) ¨ (i => " {flat[2 * i]}=\"{escape(flat[2 * i + 1])}\""), "")
    }

    // [name, value, name, value, …]: the attributes, and data-e listing the
    // events the element wants
    fn flat_attrs[M](attrs: [Attr[M]]) -> [str] {
        let ps = attrs ⌿ (attrs ¨ (a => match a { Prop(_, _) => true, _ => false }))
        let names = attrs ⌿ (attrs ¨ (a => match a { Prop(_, _) => false, _ => true })) ¨ event_name
        let pairs = ps ¨ (a => match a { Prop(k, v) => [k v], _ => [] })
        let all = flatten(pairs)
        if ≢ names == 0 { all } else { concat(all, ["data-e" join(names, " ")]) }
    }

    // one list from a list of lists (joined in parallel)
    fn flatten[T](xss: [[T]]) -> [T] {
        if ≢ xss == 0 { [] } else { xss ▷ gather((x, y) => concat(x, y)) }
    }

    fn event_name[M](a: Attr[M]) -> str {
        match a {
            On(e, _) => e,
            OnText(e, _) => e,
            Prop(k, _) => k,
        }
    }

    // attributes with an empty value are left out
    fn props[M](pairs: [(str, str)]) -> [Attr[M]] { pairs ⌿ (pairs ¨ (p => p.1 != "")) ¨ (p => Prop(p.0, p.1)) }

    fn css(pairs: [(str, str)]) -> str { join(pairs ⌿ (pairs ¨ (p => p.1 != "")) ¨ (p => "{p.0}:{p.1}"), ";") }

    fn px(n: i64) -> str { if n == 0 { "" } else { "{n}px" } }

    pub fn escape(t: str) -> str { replace(replace(replace(replace(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;") }

    fn theme() -> str {
        ':root{color-scheme:light dark}body{margin:0;padding:24px;font:16px/1.45 system-ui,-apple-system,sans-serif;color:#1d1d1f;background:#fafafa}button{font:inherit;padding:6px 14px;border-radius:8px;border:1px solid #c9c9cf;background:#fff;color:inherit;cursor:pointer}button:hover{background:#f0f0f3}input[type=text]{font:inherit;padding:6px 10px;border-radius:8px;border:1px solid #c9c9cf;background:#fff;color:inherit;min-width:12em}a{color:#2f6fdf}hr{border:none;border-top:1px solid #ddd;width:100%}@media(prefers-color-scheme:dark){body{color:#eee;background:#151517}button,input[type=text]{background:#232327;border-color:#3a3a40}button:hover{background:#2c2c31}hr{border-top-color:#333}}'
    }

    // ---- what changed -------------------------------------------------------------

    // The patches that turn screen `a` into screen `b` (both at `path`).
    pub fn diff[M](a: Node[M], b: Node[M], path: str) -> [Patch] {
        match (a, b) {
            (Elem(t1, a1, k1), Elem(t2, a2, k2)) if t1 == t2 => {
                let mine = if same_attrs(a1, a2) { [] } else { [Patch { op: "attrs", p: path, html: "", attrs: flat_attrs(a2), at: 0 }] }
                concat(mine, kids_diff(k1, k2, path))
            }
            (Txt(x), Txt(y)) if x == y => [],
            _ => [Patch { op: "replace", p: path, html: render(b, path), attrs: [], at: 0 }],
        }
    }

    fn kids_diff[M](k1: [Node[M]], k2: [Node[M]], path: str) -> [Patch] {
        // a list is keyed when its rows are (its first row tells)
        let keyed = if ≢ k1 == 0 or ≢ k2 == 0 { false } else { key_of(k1[0]) != "" and key_of(k2[0]) != "" }
        if keyed {
            let keys1 = k1 ¨ key_of
            let keys2 = k2 ¨ key_of
            if same(keys1, keys2) { pairwise(k1, k2, path, ≢ k1) } else { keyed_diff(k1, k2, keys1, keys2, path) }
        } else if ≢ k1 == ≢ k2 {
            if any_text_differs(k1, k2) { whole_list(k2, path) } else { pairwise(k1, k2, path, ≢ k1) }
        } else if all_elems(k1) and all_elems(k2) {
            if ≢ k2 > ≢ k1 {
                // grown at the end: the old rows, then the new ones appended
                let more = ⍳ (≢ k2 - ≢ k1) ¨ (i => render(k2[≢ k1 + i], "{path}.{≢ k1 + i}"))
                concat(pairwise(k1, k2, path, ≢ k1), [Patch { op: "append", p: path, html: join(more, ""), attrs: [], at: 0 }])
            } else {
                // shrunk at the end
                concat([Patch { op: "trim", p: path, html: "", attrs: [], at: ≢ k2 }], pairwise(k1, k2, path, ≢ k2))
            }
        } else {
            whole_list(k2, path)
        }
    }

    fn whole_list[M](k2: [Node[M]], path: str) -> [Patch] { [Patch { op: "children", p: path, html: kids_html(k2, path), attrs: [], at: 0 }] }

    fn pairwise[M](k1: [Node[M]], k2: [Node[M]], path: str, n: i64) -> [Patch] {
        flatten(⍳ n ¨ (i => diff(k1[i], k2[i], "{path}.{i}")))
    }

    // (`and` evaluates both sides: compare texts only when the lengths match)
    fn any_text_differs[M](k1: [Node[M]], k2: [Node[M]]) -> bool {
        if ≢ k1 != ≢ k2 { true } else { ((⍳ ≢ k1 ¨ (i => if text_differs(k1[i], k2[i]) { 1 } else { 0 })) ▷ +/) > 0 }
    }

    fn all_elems[M](ks: [Node[M]]) -> bool { ((ks ¨ (k => match k { Txt(_) => 1, _ => 0 })) ▷ +/) == 0 }

    fn key_of[M](n: Node[M]) -> str {
        match n {
            Elem(_, attrs, _) => key_in(attrs),
            Txt(_) => "",
        }
    }

    fn key_in[M](attrs: [Attr[M]]) -> str {
        if ≢ attrs == 0 {
            ""
        } else {
            match attrs[0] {
                Prop(k, v) if k == "data-key" => v,
                _ => key_in(attrs ↓ 1),
            }
        }
    }

    // Rows matched by key: removals (last first), then insertions (first
    // first), then changes inside the rows that stayed. Reordered rows (or
    // repeated keys) re-render the list.
    fn keyed_diff[M](k1: [Node[M]], k2: [Node[M]], keys1: [str], keys2: [str], path: str) -> [Patch] {
        let pos1 = map_of(keys1, ⍳ ≢ keys1)
        let pos2 = map_of(keys2, ⍳ ≢ keys2)
        let kept = keys1 ¨ (k => has(pos2, k))
        let order = (keys1 ⌿ kept) ¨ (k => pos2[k])
        let in_order = if ≢ order < 2 { true } else { ((⍳ (≢ order - 1) ¨ (i => if order[i] < order[i + 1] { 0 } else { 1 })) ▷ +/) == 0 }
        // every row keyed, each key once, nothing moved: else re-render
        let unkeyed = has(pos1, "") or has(pos2, "")
        if unkeyed or ≢ pos1 != ≢ keys1 or ≢ pos2 != ≢ keys2 or not in_order {
            whole_list(k2, path)
        } else {
            let gone = ⌽ ((⍳ ≢ k1) ⌿ (kept ¨ (b => not b)))
            let removes = gone ¨ (i => Patch { op: "remove", p: path, html: "", attrs: [], at: i })
            let fresh = (⍳ ≢ k2) ⌿ (keys2 ¨ (k => not has(pos1, k)))
            let inserts = fresh ¨ (j => Patch { op: "insert", p: path, html: render(k2[j], "{path}.{j}"), attrs: [], at: j })
            let stayed = (⍳ ≢ k2) ⌿ (keys2 ¨ (k => has(pos1, k)))
            let changes = flatten(stayed ¨ (j => diff(k1[pos1[keys2[j]]], k2[j], "{path}.{j}")))
            concat(concat(removes, inserts), changes)
        }
    }

    // two lists of text, equal as a whole (`==` on lists is elementwise)
    fn same(a: [str], b: [str]) -> bool {
        if ≢ a != ≢ b { false } else { ((⍳ ≢ a ¨ (i => if a[i] == b[i] { 0 } else { 1 })) ▷ +/) == 0 }
    }

    fn text_differs[M](a: Node[M], b: Node[M]) -> bool {
        match (a, b) {
            (Txt(x), Txt(y)) => x != y,
            (Elem(_, _, _), Elem(_, _, _)) => false,
            _ => true,
        }
    }

    // the same attributes and events (handlers are looked up when an event
    // comes, so only their names matter here)
    fn same_attrs[M](a: [Attr[M]], b: [Attr[M]]) -> bool {
        if ≢ a != ≢ b { false } else { ((⍳ ≢ a ¨ (i => if same_attr(a[i], b[i]) { 0 } else { 1 })) ▷ +/) == 0 }
    }

    fn same_attr[M](a: Attr[M], b: Attr[M]) -> bool {
        match (a, b) {
            (Prop(k1, v1), Prop(k2, v2)) => k1 == k2 and v1 == v2,
            (On(e1, _), On(e2, _)) => e1 == e2,
            (OnText(e1, _), OnText(e2, _)) => e1 == e2,
            _ => false,
        }
    }


    // ---- events -------------------------------------------------------------------

    // The message an event (JSON from the browser script) stands for, if any.
    pub fn message[M](tree: Node[M], event: str) -> Option[M] {
        match super::json::decode[Event](event) {
            Ok(ev) => {
                let path = (split(ev.p, ".") ↓ 1) ¨ (x => match parse_int(x) { Some(k) => k, None => -1 })
                match node_at(tree, path) {
                    Some(Elem(_, attrs, _)) => handler(attrs, ev),
                    _ => None,
                }
            }
            Err(_) => None,
        }
    }

    fn node_at[M](n: Node[M], path: [i64]) -> Option[Node[M]] {
        if ≢ path == 0 {
            Some(n)
        } else {
            match n {
                Elem(_, _, kids) => if path[0] >= 0 and path[0] < ≢ kids { node_at(kids[path[0]], path ↓ 1) } else { None },
                Txt(_) => None,
            }
        }
    }

    fn handler[M](attrs: [Attr[M]], ev: Event) -> Option[M] {
        if ≢ attrs == 0 {
            None
        } else {
            match attrs[0] {
                On(e, m) if e == ev.e => Some(m),
                OnText(e, f) if e == ev.e => Some(f(ev.v)),
                _ => handler(attrs ↓ 1, ev),
            }
        }
    }
}
