module main

// sudoku: 200 puzzles (full grids relabelled and emptied in part, from
// splitmix64) solved by backtracking: the first empty cell in reading
// order gets the digits 1 … 9 that fit, in order, the first complete grid
// winning. Each placement is a new board (`put` on one still in use
// copies its 81 cells); the puzzles are solved in parallel. Prints the sum
// over the puzzles of the top row of the solution read as a 9-digit
// number, and the number of placements tried in all. The reference is
// bench/sudoku/ref.py.

fn mix(v: i64) -> i64 {
    let x1 = (v + 1) * 0x9E3779B97F4A7C15
    let x2 = (x1 ^ x1 >>> 30) * 0xBF58476D1CE4E5B9
    let x3 = (x2 ^ x2 >>> 27) * 0x94D049BB133111EB
    (x3 ^ x3 >>> 31) >>> 1
}

// the digits 1 … 9 relabelled for puzzle p (Fisher-Yates)
type Perm = { i: i64, d: [i64] }

fn shuffle_step(s: Perm, p: i64) -> Perm {
    let j = mix(1000 * p + s.i) % (s.i + 1)
    let (a, b) = (s.d[s.i], s.d[j])
    { s with i: s.i - 1, d: put(put(s.d, s.i, b), j, a) }
}

fn puzzle(p: i64) -> [i64] {
    let perm = (Perm { i: 8, d: ⍳ 9 ¨ (k => k + 1) } ▷ evolve(8, s => shuffle_step(s, p))).d
    ⍳ 81 ¨ (i => if mix(81 * p + i) % 100 < 62 { 0 } else { perm[(3 * (i div 9 % 3) + i div 9 div 3 + i % 9) % 9] })
}

// can digit v go at cell i? (its row, column and box checked from k on)
fn fits(b: [i64], i: i64, v: i64, k: i64) -> bool {
    if k == 9 { true } else {
        let (r, c) = (i div 9, i % 9)
        let (br, bc) = (r - r % 3, c - c % 3)
        if b[r * 9 + k] == v or b[k * 9 + c] == v or b[(br + k div 3) * 9 + bc + k % 3] == v { false } else { fits(b, i, v, k + 1) }
    }
}

// a board, whether it is solved, and the placements tried so far
type S = { b: [i64], ok: bool, tried: i64 }

fn first_empty(b: [i64], i: i64) -> i64 { if i == 81 or b[i] == 0 { i } else { first_empty(b, i + 1) } }

// digits v … 9 at cell i
fn attempt(b: [i64], i: i64, v: i64, tried: i64) -> S {
    if v > 9 { S { b: b, ok: false, tried: tried } }
    else if fits(b, i, v, 0) {
        let r = solve(put(b, i, v), tried + 1)
        if r.ok { r } else { attempt(b, i, v + 1, r.tried) }
    } else { attempt(b, i, v + 1, tried + 1) }
}

fn solve(b: [i64], tried: i64) -> S {
    let i = first_empty(b, 0)
    if i == 81 { S { b: b, ok: true, tried: tried } } else { attempt(b, i, 1, tried) }
}

// the top row read as a 9-digit number
fn number(b: [i64], c: i64, n: i64) -> i64 { if c == 9 { n } else { number(b, c + 1, n * 10 + b[c]) } }

fn main() {
    let results = ⍳ 200 ¨ (p => solve(puzzle(p), 0))
    let rows = results ¨ (r => number(r.b, 0, 0))
    print("{rows ▷ +/} {results ¨ (r => r.tried) ▷ +/}")
}
