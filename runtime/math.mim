
// Mathematics on floats: math::sqrt(2.0), math::sin(x), math::pi(). On
// numbers the compiler knows, these are single machine instructions or libm
// calls, so they fuse into array kernels. (Appended to the prelude.)
pub module math {
    pub extern "mimic" {
        fn sqrt(x: f64) -> f64
        fn sin(x: f64) -> f64
        fn cos(x: f64) -> f64
        fn tan(x: f64) -> f64
        fn asin(x: f64) -> f64
        fn acos(x: f64) -> f64
        fn atan(x: f64) -> f64
        fn atan2(y: f64, x: f64) -> f64
        fn hypot(x: f64, y: f64) -> f64
        fn exp(x: f64) -> f64
        fn ln(x: f64) -> f64
        fn log2(x: f64) -> f64
        fn log10(x: f64) -> f64
        fn pow(x: f64, y: f64) -> f64
        fn floor(x: f64) -> f64
        fn ceil(x: f64) -> f64
        fn round(x: f64) -> f64
    }

    // π
    pub fn pi() -> f64 { 3.141592653589793 }

    // e, the base of natural logarithms
    pub fn e() -> f64 { 2.718281828459045 }
}
