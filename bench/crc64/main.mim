module main

// crc64: CRC-64/XZ (reflected polynomial 0xC96C5795D7870F42, initial value
// and final xor all ones) of 8 MiB of generated bytes, with a 256-entry
// table built by one map. One sequential pass over the bytes (a function
// that calls itself). The reference is bench/crc64/ref.py, checked against
// the catalogue's check value.

fn poly() -> i64 { 0xC96C5795D7870F42 }

// the table entry for byte b: 8 shifts
fn entry(c: i64, k: i64) -> i64 {
    if k == 8 { c } else { entry(if c & 1 == 1 { c >>> 1 ^ poly() } else { c >>> 1 }, k + 1) }
}

fn crc(data: [u8], table: [i64], i: i64, c: i64) -> i64 {
    if i == ≢ data { c } else { crc(data, table, i + 1, table[(c ^ data[i]) & 255] ^ c >>> 8) }
}

fn main() {
    let table = ⍳ 256 ¨ (b => entry(b, 0))
    let data = bytes::from(⍳ (1 << 23) ¨ (i => (i * 2654435761 >> 13) & 255))
    let c = crc(data, table, 0, ¯1) ^ ¯1
    print(bytes::hex(bytes::from(⍳ 8 ¨ (i => c >>> (56 - 8 * i) & 255))))
}
