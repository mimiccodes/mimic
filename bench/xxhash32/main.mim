module main

// xxhash32: xxHash32 (seed 0) of 8 MiB of generated bytes: four lanes,
// each fed every fourth 32-bit word, then merged and mixed. One sequential
// pass over 16-byte stripes.

fn rotl(x: i64, r: i64) -> i64 { (x << r | x >>> (32 - r)) & 0xFFFFFFFF }

fn round(acc: i64, w: i64) -> i64 { rotl((acc + w * 0x85EBCA77) & 0xFFFFFFFF, 13) * 0x9E3779B1 & 0xFFFFFFFF }

fn word(data: [i64], p: i64) -> i64 { data[p] | data[p + 1] << 8 | data[p + 2] << 16 | data[p + 3] << 24 }

fn main() {
    let n = 1 << 23
    let data = ⍳ n ¨ (i => (i * 2654435761 >> 13) & 255)
    let stripes = n div 16
    let start = (0, (0x9E3779B1 + 0x85EBCA77) & 0xFFFFFFFF, 0x85EBCA77, 0, (0 - 0x9E3779B1) & 0xFFFFFFFF)
    let (_, v1, v2, v3, v4) = start ▷ settle(s => {
        let p = s.0 * 16
        (s.0 + 1, round(s.1, word(data, p)), round(s.2, word(data, p + 4)), round(s.3, word(data, p + 8)), round(s.4, word(data, p + 12)))
    }, s => s.0 == stripes)
    let h0 = (rotl(v1, 1) + rotl(v2, 7) + rotl(v3, 12) + rotl(v4, 18) + n) & 0xFFFFFFFF
    let h1 = (h0 ^ h0 >>> 15) * 0x85EBCA77 & 0xFFFFFFFF
    let h2 = (h1 ^ h1 >>> 13) * 0xC2B2AE3D & 0xFFFFFFFF
    print(h2 ^ h2 >>> 16)
}
