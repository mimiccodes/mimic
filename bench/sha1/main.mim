module main

// sha1: the SHA-1 digest (FIPS 180-4) of 4 MiB of generated bytes. Blocks
// of 64 bytes one after another (`evolve`); in a block, the 80-word
// message schedule grows in place (a named step), then 80 rounds as a
// function that calls itself with the five working words. Checked against
// Python's `hashlib`.

fn rotl(x: i64, r: i64) -> i64 { (x << r | x >>> (32 - r)) & 0xFFFFFFFF }

// the schedule of the block at off: 16 words read big-endian, then 64 more
type W = { w: [i64] }

fn more(s: W) -> W {
    let t = ≢ s.w
    let v = rotl(s.w[t - 3] ^ s.w[t - 8] ^ s.w[t - 14] ^ s.w[t - 16], 1)
    { s with w: push(s.w, v) }
}

fn schedule(msg: [u8], off: i64) -> [i64] {
    let first = ⍳ 16 ¨ (j => {
        let p = off + 4 * j
        msg[p] << 24 | msg[p + 1] << 16 | msg[p + 2] << 8 | msg[p + 3]
    })
    (W { w: first } ▷ evolve(64, more)).w
}

// rounds t … 79 on the working words
fn rounds(w: [i64], t: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> (i64, i64, i64, i64, i64) {
    if t == 80 { (a, b, c, d, e) } else {
        let f = if t < 20 { b & c | (b ^ 0xFFFFFFFF) & d } else if t < 40 { b ^ c ^ d } else if t < 60 { b & c | b & d | c & d } else { b ^ c ^ d }
        let k = if t < 20 { 0x5A827999 } else if t < 40 { 0x6ED9EBA1 } else if t < 60 { 0x8F1BBCDC } else { 0xCA62C1D6 }
        let tmp = (rotl(a, 5) + f + e + k + w[t]) & 0xFFFFFFFF
        rounds(w, t + 1, tmp, a, rotl(b, 30), c, d)
    }
}

type H = { off: i64, a: i64, b: i64, c: i64, d: i64, e: i64 }

fn block(h: H, msg: [u8]) -> H {
    let (a, b, c, d, e) = rounds(schedule(msg, h.off), 0, h.a, h.b, h.c, h.d, h.e)
    { h with off: h.off + 64, a: (h.a + a) & 0xFFFFFFFF, b: (h.b + b) & 0xFFFFFFFF, c: (h.c + c) & 0xFFFFFFFF, d: (h.d + d) & 0xFFFFFFFF, e: (h.e + e) & 0xFFFFFFFF }
}

fn main() {
    let n = 1 << 22
    // the data, then 0x80, zeros, and the length in bits (big-endian)
    let bits = n * 8
    let msg = bytes::from(⍳ (n + 64) ¨ (i => {
        if i < n { (i * 2654435761 >> 13) & 255 }
        else if i == n { 128 }
        else if i < n + 56 { 0 }
        else { bits >>> ((n + 63 - i) * 8) & 255 }
    }))
    let h = H { off: 0, a: 0x67452301, b: 0xEFCDAB89, c: 0x98BADCFE, d: 0x10325476, e: 0xC3D2E1F0 } ▷ evolve(≢ msg div 64, h => block(h, msg))
    let words = [h.a h.b h.c h.d h.e]
    print(bytes::hex(bytes::from(⍳ 20 ¨ (i => words[i div 4] >>> (24 - i % 4 * 8) & 255))))
}
