module main

// Run-length encode a generated 5 MB string of a few distinct letters
// (each run as the letter and its length, e.g. "a3b12"), decode it again,
// and print the lengths and whether the round trip matches.

fn next(x: i64) -> i64 { (x * 1103515245 + 12345) % 2147483648 }

fn make_runs(letters: [str], n: i64, x: i64, acc: [str]) -> [str] {
    if n == 0 { acc } else {
        let a = next(x)
        let b = next(a)
        make_runs(letters, n - 1, b, push(acc, repeat(letters[a % 5], 1 + b % 9)))
    }
}

// the first position after i that holds a different letter
fn run_end(cs: [str], i: i64, j: i64) -> i64 {
    if j < ≢ cs and cs[j] == cs[i] { run_end(cs, i, j + 1) } else { j }
}

fn encode(cs: [str], i: i64, out: [str]) -> [str] {
    if i == ≢ cs { out } else {
        let j = run_end(cs, i, i)
        encode(cs, j, push(out, "{cs[i]}{j - i}"))
    }
}

fn is_digit(c: str) -> bool { char_code(c) >= 48 and char_code(c) <= 57 }

// the number starting at p, and the position after it
fn read_number(cs: [str], p: i64, value: i64) -> (i64, i64) {
    if p < ≢ cs and is_digit(cs[p]) {
        read_number(cs, p + 1, value * 10 + char_code(cs[p]) - 48)
    } else {
        (value, p)
    }
}

fn decode(cs: [str], p: i64, out: [str]) -> [str] {
    if p == ≢ cs { out } else {
        let (count, after) = read_number(cs, p + 1, 0)
        decode(cs, after, push(out, repeat(cs[p], count)))
    }
}

fn main() {
    let letters = ["a" "b" "c" "d" "e"]
    let text = make_runs(letters, 1000000, 42, []) ▷ join("")
    let encoded = encode(chars(text), 0, []) ▷ join("")
    let decoded = decode(chars(encoded), 0, []) ▷ join("")
    print(≢ text)
    print(≢ encoded)
    print(decoded == text)
}
