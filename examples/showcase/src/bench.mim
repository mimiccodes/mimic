pub module bench

// Compute-heavy algorithms. `make run` runs them at small sizes as part of
// the tour; `make parallel` runs them at full size (the `bench/` project)
// on 1 thread and on all cores.
//
// Nothing here mentions threads. The divide-and-conquer functions are pure,
// so their two recursive calls run on different cores, and the array
// expressions run as parallel kernels.

pub fn demo() {
    print(showcase::banner("bench: compute-heavy algorithms"))
    render()
    print("mandelbrot iterations (120×120, limit 200): {mandelbrot(120, 200)}")
    print("primes below 100000: {count_primes(100000)}")
    print("longest Collatz chain below 100000: {longest_collatz(100000)}")
    print("π by Monte Carlo (1M points): {monte_carlo_pi(1000000)}")
    print("π by integration (1M slices): {integrate_pi(1000000)}")
}

// ---- Mandelbrot -----------------------------------------------------------

// iterations of z → z² + c before |z| > 2 (at most `limit`)
pub fn escape(cx: f64, cy: f64, limit: i64) -> i64 {
    step(cx, cy, 0.0, 0.0, 0, limit)
}

fn step(cx: f64, cy: f64, x: f64, y: f64, i: i64, limit: i64) -> i64 {
    if i == limit or x × x + y × y > 4.0 {
        i
    } else {
        step(cx, cy, x × x - y × y + cx, 2.0 × x × y + cy, i + 1, limit)
    }
}

// escape count of pixel k on a size×size grid over [-2, 1] × [-1.5, 1.5]
fn pixel(k: i64, size: i64, limit: i64) -> i64 {
    let cx = (k % size) ÷ size × 3.0 - 2.0
    let cy = (k div size) ÷ size × 3.0 - 1.5
    escape(cx, cy, limit)
}

// total iterations over the whole grid: split the pixels in half until the
// pieces are small; the two halves are independent, so they run in parallel
pub fn mandelbrot(size: i64, limit: i64) -> i64 {
    pixels(0, size × size, size, limit)
}

fn pixels(lo: i64, hi: i64, size: i64, limit: i64) -> i64 {
    if hi - lo <= 64 {
        run_pixels(lo, hi, size, limit)
    } else {
        let mid = (lo + hi) div 2
        pixels(lo, mid, size, limit) + pixels(mid, hi, size, limit)
    }
}

fn run_pixels(lo: i64, hi: i64, size: i64, limit: i64) -> i64 {
    if lo == hi { 0 } else { pixel(lo, size, limit) + run_pixels(lo + 1, hi, size, limit) }
}

// ASCII art: 64×24 characters, each row built with ¨ over its pixel indices
fn render() {
    show_rows(0, 24)
}

fn show_rows(r: i64, n: i64) {
    if r < n {
        print((r × 64) ‥ ((r + 1) × 64) ¨ shade)
        show_rows(r + 1, n)
    }
}

fn shade(k: i64) {
    let cx = (k % 64) ÷ 64 × 3.0 - 2.1
    let cy = (k div 64) ÷ 24 × 2.4 - 1.2
    " .:-=+*#%@"[min(escape(cx, cy, 90) div 10, 9)]
}

// ---- primes -----------------------------------------------------------------

pub fn count_primes(n: i64) -> i64 {
    primes_in(0, n)
}

fn primes_in(lo: i64, hi: i64) -> i64 {
    if hi - lo <= 256 {
        primes_run(lo, hi)
    } else {
        let mid = (lo + hi) div 2
        primes_in(lo, mid) + primes_in(mid, hi)
    }
}

fn primes_run(lo: i64, hi: i64) -> i64 {
    if lo == hi { 0 } else { (if is_prime(lo) { 1 } else { 0 }) + primes_run(lo + 1, hi) }
}

pub fn is_prime(n: i64) -> bool {
    n >= 2 and no_divisor(n, 2)
}

fn no_divisor(n: i64, d: i64) -> bool {
    if d × d > n { true } else if n % d == 0 { false } else { no_divisor(n, d + 1) }
}

// ---- Collatz ----------------------------------------------------------------

// the longest chain for a start value below n (max of two halves, in parallel)
pub fn longest_collatz(n: i64) -> i64 {
    best(1, n)
}

fn best(lo: i64, hi: i64) -> i64 {
    if hi - lo <= 128 {
        best_run(lo, hi)
    } else {
        let mid = (lo + hi) div 2
        best(lo, mid) ⌈ best(mid, hi)
    }
}

fn best_run(lo: i64, hi: i64) -> i64 {
    if lo == hi { 0 } else { chain(lo) ⌈ best_run(lo + 1, hi) }
}

fn chain(n: i64) -> i64 {
    if n == 1 { 1 } else if n % 2 == 0 { 1 + chain(n div 2) } else { 1 + chain(3 × n + 1) }
}

// ---- π, two ways, as whole-array kernels -------------------------------------

// fraction of pseudo-random points inside the unit quarter circle, × 4
pub fn monte_carlo_pi(n: i64) -> f64 {
    let ks = ⍳ n
    let xs = (ks × 1103515245 + 12345) % 2147483648 ÷ 2147483648
    let ys = (ks × 22695477 + 1) % 2147483647 ÷ 2147483647
    let inside = xs × xs + ys × ys <= 1.0 ▷ +/
    4.0 × inside ÷ n
}

// ∫₀¹ 4 / (1 + x²) dx = π, by the midpoint rule
pub fn integrate_pi(n: i64) -> f64 {
    let xs = (⍳ n + 0.5) ÷ n
    (4.0 ÷ (1.0 + xs × xs) ▷ +/) ÷ n
}
