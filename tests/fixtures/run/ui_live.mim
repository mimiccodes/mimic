module main

// ui::run_live: a job whose result arrives later, a timer and a channel.
// (WASI: see ui_live.wasi.out.)

type Msg = Search(str) | Found(str) | Tick | News(str)
type State = { query: str, result: str, ticks: i64, news: [str] }

fn slow_upper(q: str) -> str {
    time::sleep(50ms)                       // stands for a slow request
    upper(q)
}

fn update(s: State, m: Msg) -> ui::Step[State, Msg] {
    match m {
        Search(q) => ui::then({ s with query: q, result: "searching" }, () => Found(slow_upper(q))),
        Found(r) => ui::stay({ s with result: "found {r}" }),
        Tick => ui::stay({ s with ticks: s.ticks + 1 }),
        News(n) => ui::stay({ s with news: push(s.news, n) }),
    }
}

fn view(s: State) -> ui::Node[Msg] {
    ui::column([
        ui::input(s.query, on_input: Search),
        ui::text(s.result),
        ui::text("ticks: {s.ticks}"),
        ui::column(s.news ¨ (n => ui::text("news: {n}"))),
    ])
}

fn app(port: i64, news: chan::Receiver[Msg]) -> Result[i64, str] {
    let init = State { query: "", result: "", ticks: 0, news: [] }
    ui::run_live(init, view, update, subscriptions: [ui::every(30ms, Tick), ui::listen(news)], port: port, connections: 2)
}

fn when_up(url: str, tries: i64) -> Result[http::Response, str] {
    match http::fetch(url) {
        Ok(r) => Ok(r),
        Err(e) => if tries <= 1 or starts_with(e, "networking is not available") { Err(e) } else { time::sleep(20ms); when_up(url, tries - 1) },
    }
}

// read patches until one mentions `needle`
fn wait_for(sock: ws::Socket, needle: str, tries: i64) -> bool {
    if tries == 0 {
        false
    } else {
        match ws::receive(sock) {
            Ok(ws::Text(t)) => if contains(t, needle) { true } else { wait_for(sock, needle, tries - 1) },
            _ => false,
        }
    }
}

fn main() {
    let port = 30000 + os::pid() % 20000
    let (news_tx, news_rx) = chan::new[Msg]()
    let s = app(port, news_rx)
    let page = match when_up("http://127.0.0.1:{port}/", 100) {
        Ok(r) => r,
        Err(e) => {
            print("no server: {e}")
            return
        }
    }
    print(contains(page.body, "ticks: 0"))
    let sock = ws::connect("ws://127.0.0.1:{port}/ui") else { return }
    ws::send(sock, json::encode(ui::Event { p: "0.0", e: "input", v: "mimic" }))
    print(wait_for(sock, "searching", 50))            // at once
    print(wait_for(sock, "found MIMIC", 50))          // when the job is done
    print(wait_for(sock, "ticks: 3", 50))             // the timer keeps going
    chan::send(news_tx, News("hello"))
    print(wait_for(sock, "news: hello", 50))          // from the channel
    ws::close(sock)
    chan::close(news_tx)
    print(s)
}
